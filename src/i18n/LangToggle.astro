---
import { languages, useTranslations, localizedUrl } from './ui';

export interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const targetLang: 'es' | 'en' = lang === 'es' ? 'en' : 'es';
const targetUrl = localizedUrl(Astro.url.pathname, targetLang);
const label = languages[targetLang];
---

<a
  class="lang-toggle"
  href={targetUrl}
  data-lang-toggle
  aria-label={t('common.langToggle')}
  hreflang={targetLang}
>
  <span class="lang-toggle__prompt" aria-hidden="true">&gt;_</span>
  <span class="lang-toggle__label" data-lang-label>{label}</span>
  <span class="lang-toggle__cursor" aria-hidden="true">▌</span>
</a>

<script>
  import { ui, localizedUrl, getLangFromUrl } from './ui';

  const root = document.documentElement;
  const toggle = document.querySelector<HTMLAnchorElement>('[data-lang-toggle]');
  const dicts = ui as Record<string, Record<string, string>>;

  function currentLang(): 'es' | 'en' {
    return root.lang === 'en' ? 'en' : 'es';
  }

  /** Swap every [data-i18n] element, the <title>, the meta description and <html lang>. */
  function applyLang(lang: 'es' | 'en') {
    const dict = dicts[lang];
    root.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
      const key = el.dataset.i18n;
      if (key && dict[key]) el.innerHTML = dict[key];
    });

    const titleKey = root.dataset.i18nTitle;
    if (titleKey && dict[titleKey]) document.title = dict[titleKey];

    const descKey = root.dataset.i18nDesc;
    if (descKey && dict[descKey]) {
      document.querySelector('meta[name="description"]')?.setAttribute('content', dict[descKey]);
    }

    root.lang = lang;
    localStorage.setItem('compdes-lang', lang);

    if (toggle) {
      const back: 'es' | 'en' = lang === 'es' ? 'en' : 'es';
      toggle.href = localizedUrl(location.pathname, back);
      const labelEl = toggle.querySelector<HTMLElement>('[data-lang-label]');
      if (labelEl) labelEl.textContent = back === 'es' ? 'Español' : 'English';
    }
  }

  toggle?.addEventListener('click', (event) => {
    event.preventDefault();
    const from = currentLang();
    const to: 'es' | 'en' = from === 'es' ? 'en' : 'es';
    applyLang(to);
    history.pushState(null, '', localizedUrl(location.pathname, to));
  });

  // Keep the toggle in sync when the user navigates with the browser back/forward.
  window.addEventListener('popstate', () => {
    const urlLang: 'es' | 'en' = getLangFromUrl(location.pathname);
    if (urlLang !== currentLang()) applyLang(urlLang);
  });
</script>

<style>
  /* Botón terminal: prompt ">_" en acento, mono en mayúsculas con tracking,
     esquinas cuadradas como el [≡] móvil y sombra dura amarilla (la firma
     de .terminal-window) al hover. Fondo azul-900 translúcido para legibilidad
     sobre el hero (navbar transparente) y sobre la navbar sólida. */
  .lang-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.75rem;
    background-color: rgb(0 6 23 / 0.72);
    border: 2px solid var(--color-compdes-blue-600);
    border-radius: 0.25rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1;
    color: var(--color-compdes-cream);
    text-decoration: none;
    transition:
      border-color var(--duration-fast) var(--ease-out-quart),
      color var(--duration-fast) var(--ease-out-quart),
      box-shadow var(--duration-fast) var(--ease-out-quart),
      transform var(--duration-fast) var(--ease-out-quart);
  }

  .lang-toggle__prompt {
    color: var(--color-compdes-yellow);
  }

  .lang-toggle__cursor {
    color: var(--color-compdes-yellow);
    animation: lang-toggle-blink 1.1s steps(1) infinite;
  }

  .lang-toggle:hover {
    border-color: var(--color-compdes-yellow);
    color: var(--color-compdes-yellow);
    box-shadow: 3px 3px 0 0 var(--color-compdes-yellow);
    transform: translate(-1px, -1px);
  }

  .lang-toggle:active {
    box-shadow: 1px 1px 0 0 var(--color-compdes-yellow);
    transform: translate(0, 0);
  }

  @keyframes lang-toggle-blink {
    50% {
      opacity: 0;
    }
  }
</style>
