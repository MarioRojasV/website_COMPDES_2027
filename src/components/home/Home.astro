---
import Hero from './Hero.astro';
import IeeeSection from './IeeeSection.astro';
import CallForPapers from './CallForPapers.astro';
import LocationSection from './LocationSection.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { useTranslations } from '../../i18n/ui';

const lang = (Astro.currentLocale as 'es' | 'en') ?? 'es';
const t = useTranslations(lang);
---

<Hero />

<!-- [ sec.01 ] Bienvenida -->
<section id="que-es" class="bg-compdes-blue py-16 text-compdes-cream md:py-24">
  <div class="mx-auto max-w-4xl px-6">
    <SectionHeading
      sectionNumber={1}
      eyebrowKey="home.about.eyebrow"
      titleKey="home.about.title"
      introKey="home.about.intro"
      dark
    />
  </div>
</section>

<!-- [ sec.02 ] Información general -->
<section class="border-y-2 border-compdes-yellow bg-compdes-blue-800 py-16 text-compdes-cream md:py-24">
  <div class="mx-auto max-w-4xl px-6">
    <SectionHeading
      sectionNumber={2}
      eyebrowKey="home.info.eyebrow"
      titleKey="home.info.title"
      introKey="home.info.intro"
      align="center"
      dark
    />
  </div>
</section>

<!-- [ sec.03 ] Indexación IEEE -->
<IeeeSection />

<!-- [ sec.04 ] Call for Papers -->
<CallForPapers />

<!-- [ sec.05 ] Contacto -->
<section class="border-y-2 border-compdes-yellow bg-compdes-blue py-16 text-compdes-cream md:py-24">
  <div class="mx-auto max-w-4xl px-6">
    <SectionHeading
      sectionNumber={5}
      eyebrowKey="home.contact.eyebrow"
      titleKey="home.contact.title"
      align="center"
      dark
    />

    <div class="terminal-window corner mt-8">
      <div class="term-titlebar">
        <span class="term-dots"><i></i><i></i><i></i></span>
        <span data-i18n="home.contact.title">{t('home.contact.title').toLowerCase()}</span>
        <span class="hidden sm:inline">fs</span>
      </div>
      <div class="space-y-3 px-6 py-6 font-mono text-sm">
        <p class="text-compdes-cream">
          <span class="text-compdes-cream/60" data-i18n="home.contact.email">{t('home.contact.email')}: </span>
          <span data-i18n="home.contact.emailValue">{t('home.contact.emailValue')}</span>
        </p>
        <p class="text-compdes-cream">
          <span class="text-compdes-cream/60" data-i18n="home.contact.phone">{t('home.contact.phone')}: </span>
          <span data-i18n="home.contact.phoneValue">{t('home.contact.phoneValue')}</span>
        </p>
        <p class="text-compdes-cream">
          <span class="text-compdes-cream/60" data-i18n="home.contact.social">{t('home.contact.social')}: </span>
          <span data-i18n="home.contact.socialValue">{t('home.contact.socialValue')}</span>
        </p>
        <p class="pt-2 text-compdes-yellow">
          <span class="blink">▌</span>
        </p>
      </div>
    </div>
  </div>
</section>

<!-- [ sec.05 ] Ubicación -->
<LocationSection />

<!-- Acknowledgement obligatorio de Microsoft CMT (requisito para indexación IEEE).
     TEXTO FIJO: no traducir, no estilizar, no modificar — debe quedar intacto,
     en texto plano y hard-codeado en el HTML de la página principal.
     El fondo/color van en el CONTENEDOR; el <p> se mantiene sin atributos. -->
<div class="bg-compdes-blue px-6 py-10 text-compdes-cream">
  <div class="mx-auto max-w-4xl">
    <p>
      The Microsoft CMT service was used for managing the peer-reviewing process for this conference. This service was provided for free by Microsoft and they bore all expenses, including costs for Azure cloud services as well as for software development and support.
    </p>
  </div>
</div>
