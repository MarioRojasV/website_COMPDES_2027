---
import { useTranslations } from '../../i18n/ui';

const lang = (Astro.currentLocale as 'es' | 'en') ?? 'es';
const t = useTranslations(lang);
---

<section class="hero" aria-label={t('hero.title')}>
  <img class="hero-bg" src="/fondos/principal.webp" alt="" />
  <img id="hero-logo" class="hero-logo" src="/fondos/volcano.webp" alt="" />
  <div class="hero-scrim"></div>

  <div class="hero-inner">
    <h1 class="hero-title font-display font-bold" data-i18n="hero.title">
      <span class="block">COMPDES</span>
      <span class="block text-compdes-yellow">2027</span>
    </h1>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100vh;
    min-height: 560px;
    overflow: hidden;
    background-color: var(--color-compdes-blue);
  }

  .hero-bg,
  .hero-logo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    will-change: transform;
  }

  .hero-bg {
    transform: scale(1.15);
  }

  .hero-logo {
    transform: scale(1.2);
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(to bottom, rgb(0 49 83 / 0.35), transparent 35%),
      linear-gradient(to top, rgb(0 49 83 / 0.45), transparent 40%);
    pointer-events: none;
  }

  .hero-inner {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding: 0 max(1.5rem, 6vw);
    text-align: left;
    will-change: transform;
  }

  .hero-title {
    color: var(--color-compdes-cream);
    font-size: clamp(3.5rem, 11vw, 8.5rem);
    line-height: 1.05;
    letter-spacing: 0.01em;
    text-shadow:
      0 2px 6px rgb(0 0 0 / 0.55),
      0 10px 40px rgb(0 0 0 / 0.45);
    will-change: transform, opacity;
  }
</style>

<script>
  const hero = document.querySelector('.hero');
  const bg = document.querySelector('.hero-bg');
  const logo = document.querySelector('#hero-logo');
  const title = document.querySelector('.hero-title');

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let ticking = false;

  function update() {
    ticking = false;
    if (reduceMotion || !hero) return;

    const max = hero.offsetHeight;
    if (max === 0) return;

    const y = Math.max(0, window.scrollY);
    const p = Math.min(y / max, 1);

    if (bg) bg.style.transform = `scale(1.15) translate3d(0, ${p * 40}px, 0)`;
    if (logo) logo.style.transform = `scale(1.2) translate3d(0, ${p * 95}px, 0)`;
    if (title) {
      title.style.transform = `translate3d(0, ${p * 180}px, 0)`;
      title.style.opacity = String(1 - p * 0.35);
    }
  }

  function onScroll() {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(update);
    }
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  update();
</script>