---
import { useTranslations } from '../../i18n/ui';

const lang = (Astro.currentLocale as 'es' | 'en') ?? 'es';
const t = useTranslations(lang);
---

<section class="hero" aria-label={t('hero.title')}>
  <div class="hero-art" aria-hidden="true">
    <img class="hero-bg" src={`${import.meta.env.BASE_URL}/fondos/principal_extendido.webp`} alt="" />
    <img id="hero-logo" class="hero-logo" src={`${import.meta.env.BASE_URL}/fondos/volcano.webp`} alt="" />
    <img class="hero-ctec" src={`${import.meta.env.BASE_URL}/fondos/ctec.webp`} alt="" />
    <img class="hero-deer" src={`${import.meta.env.BASE_URL}/fondos/deer.webp`} alt="" />
  </div>

  <!-- Velo inferior de integración: funde la base de la viñeta con el azul
       plano y con la sección siguiente (mismo color, nunca negro). -->
  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="hero-inner">
    <h1 class="hero-title font-mono font-bold" data-i18n="hero.title">
      <span class="block">COMPDES</span>
      <span class="block text-compdes-yellow">2027</span>
    </h1>
  </div>
</section>

<style>
  .hero {
    position: relative;
    /* Altura = la MAYOR entre la ventana completa y el alto que le
       correspondería al ancho completo a proporción 16:9 (la proporción
       real de las 4 imágenes del hero). En pantallas normales o angostas,
       100svh siempre gana y el comportamiento es igual al original
       (altura = ventana). En monitores ultra-wide, donde el ancho es
       desproporcionado respecto al alto, calc(100vw * 9/16) gana y la
       sección crece más alta que la ventana — el usuario hace un poco
       más de scroll para pasarla, pero object-fit:cover ya no tiene que
       agrandar ni recortar la escena, porque en ese punto el contenedor
       queda con la misma proporción 16:9 que la imagen. La navbar
       transparente FLOTA sobre el hero (position:absolute), así que no
       hay que restarle altura. Piso de 560px para pantallas angostas. */
    height: max(100vh, calc(100vw * 9 / 16));
    height: max(100svh, calc(100vw * 9 / 16));
    min-height: 560px;
    overflow: hidden;
    background-color: var(--color-compdes-blue-900);
  }

  /* Contenedor de capas a sangre completa: abarca todo el panel, de borde
     a borde de la página, siempre al 100% del ancho de la ventana (sin
     letterboxing lateral). Las 4 capas dentro son piezas de una misma
     escena con parallax, superpuestas y alineadas entre sí porque todas
     comparten exactamente este mismo tamaño. */
  .hero-art {
    position: absolute;
    inset: 0;
    pointer-events: none;
    user-select: none;
  }

  .hero-bg,
  .hero-logo,
  .hero-ctec,
  .hero-deer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
  }

  .hero-bg,
  .hero-logo,
  .hero-ctec,
  .hero-deer {
    object-position: center 65%;
    transform-origin: center bottom;
  }

  /* Solo las capas animadas declaran will-change; principal queda fija.
     transform-origin abajo: el sangrado por escala (bleed) crece hacia
     ARRIBA, anclando la escena a su base y ocultando el borde superior
     recortado de cada capa aunque el parallax las empuje hacia abajo. */
  .hero-logo,
  .hero-ctec,
  .hero-deer {
    will-change: transform;
  }

  .hero-logo,
  .hero-ctec {
    transform-origin: center bottom;
  }

  /* Profundidad: el título queda UNA CAPA POR DETRÁS del deer (z 2 > 1),
     pero por encima de volcano/ctec/principal (sin z-index). */
  .hero-deer {
    z-index: 2;
  }

  /* Velo inferior de integración: funde la base de TODAS las capas (deer
     incluido, va por encima con z 3) con el azul plano y con la sección
     siguiente — degradado del color del panel, nunca negro. */
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 3;
    background: linear-gradient(to top, var(--color-compdes-blue-900), transparent 25%);
    pointer-events: none;
  }

  .hero-inner {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding: 0 max(1.5rem, 6vw) max(10rem, 46svh) max(3rem, 9vw);
    text-align: left;
    will-change: transform;
  }

  .hero-title {
    color: var(--color-compdes-cream);
    font-size: clamp(2.75rem, 8.75vw, 6.75rem);
    line-height: 1.05;
    letter-spacing: 0;
    /* Sombra suave: difuminados amplios y poca opacidad para separar el
       texto del fondo sin dureza. */
    text-shadow:
      0 2px 14px rgb(0 0 0 / 0.35),
      0 10px 56px rgb(0 0 0 / 0.3);
    will-change: transform, opacity;
  }
</style>

<script>
  const hero = document.querySelector('.hero');
  const bg = document.querySelector('.hero-bg');
  const logo = document.querySelector('#hero-logo');
  const ctec = document.querySelector('.hero-ctec');
  const deer = document.querySelector('.hero-deer');
  const title = document.querySelector('.hero-title');

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* =====================================================================
     PROFUNDIDAD (depth) — fracción de la altura del hero que cada capa se
     "resiste" a avanzar durante el scroll.

     MECÁNICA: este parallax funciona por RESISTENCIA. Mientras la página
     sube en el scroll, cada capa se traslada hacia ABAJO (translateY +)
     respecto de su panel, contrarrestando parte del avance y quedándose
     "atrás". El movimiento neto que ve el ojo en pantalla es:

         neto = −avance_de_la_página + depth × altura_del_hero

     Por eso el valor NO es una intuición de "qué tan rápido va la capa":
     lo que el ojo percibe por cada px de scroll es un FACTOR DE PANTALLA:

         factor = 1 − depth      (≈ trazado visual de la capa en pantalla)

     Por 100 px de scroll, la capa se mueve (1 − depth) × 100 px hacia
     arriba. Solo el venado (factor ≈ 1.0) viaja a la velocidad del scroll;
     todas las demás capas van MÁS LENTAS que el scroll. De cerca a lejos:

         venado  → depth 0.00  factor ≈ 1.00  → corre con el scroll
         COMPDES → depth 0.25  factor ≈ 0.75  → fuerte, más lento que el
                                                venado
         ctec    → depth 0.50  factor ≈ 0.50  → claramente más lento que
                                                el scroll y que el texto
         volcán  → depth 0.80  factor ≈ 0.20  → sutil: cumbre lejana,
                                                bastante más lento que el
                                                edificio y apenas más rápido
                                                que el cielo
         cielo   → depth 0.90  factor ≈ 0.10  → ya FINAL. NO MODIFICAR.

     RELACIÓN CRÍTICA: ctec > volcán. El edificio + grama está físicamente
     MÁS CERCA del observador que la cima del volcán, así que su trazado por
     unidad de scroll DEBE ser mayor (0.50 vs 0.20 en pantalla, es decir el
     edificio recorre 2.5× lo que recorre el volcán para el mismo scroll).
     El cielo conserva exactamente su recorrido actual (0.10): un casi-fijo
     con un suspiro mínimo, sin estirar más la escena base.

INERCIA (omega) — inercia INDEPENDIENTE del factor: no altera el
     recorrido total (la jerarquía de arriba se conserva tal cual), solo la
     FORMA en que cada capa responde al cambio del scroll. Cada capa con
     omega > 0 mantiene un "slip" (pos): la separación con el avance de la
     página. Al reposo slip = 0 → la capa queda exactamente donde estaba
     antes (mismo frame que hoy, solo hay que restablecer la escena desde el
     estado de reposo). Cuando el scroll cambia, la capa se queda CLAVADA al
     viewport un instante mínimo — el avance de la página se absorbe en el
     offset (offset = base + delta − slip) — y luego se despega hacia su
     factor real con un resorte CRÍTICAMENTE AMORTIGUADO (velocidad inicial
     0, sin rebote ni overshoot), asentándose en 0.2–0.5 s según la capa. El
     ensamblaje es idéntico al bajar que al subir, y el objetivo (slip) se
     recalcula desde el scroll en cada frame. `omega` (rad/s) es la rigidez:
     cuánto más alta, más "instantánea" es la respuesta.

         venado  → sin spring   instantáneo (atado a tu scroll)
         COMPDES → omega 45     casi instantáneo, imperceptible (~0.13 s)
         ctec    → omega 18     ligera inercia, catch-up ágil (~0.32 s)
         volcán  → omega 12     la mayor inercia sutil, se asienta en
                                 0.4–0.5 s, SIN parecer rezagado ni lento
         cielo   → sin spring   NO MODIFICAR (idéntico a hoy)

     DIFERENCIA CLAVE con el suavizado exponencial: el exponencial arranca
     moviéndose al ritmo del scroll y luego decanta (lo que se percibe como
     "sigue al scroll y se asienta"); el resorte de slip, en cambio, aguanta
     el golpe del scroll (la capa no salta con la página) y luego se precipita
     a su posición — inercia física y catch-up rápido.

     Las capas volcán/edificio/venado son paneles ancho-completo con el
     cielo recortado (transparente) POR ENCIMA de su silueta, así que al
     trasladarse hacia abajo nunca marcan bordes: exponen el cielo de la
     capa base, que está siempre detrás. La capa base es la única opaca en
     el cielo: por eso su sobréalto (bleed) se ajusta en runtime según su
     propio recorrido (computeBleed), para que su borde superior jamás se
     descubra ni aparezca el azul de la página.
     ===================================================================== */
  const layers = [
    { el: bg,    depth: 0.9, base: 0,   sy: null, omega: 0 },
    { el: logo,  depth: 0.8, base: 0,   sy: 1.0,  omega: 18 },
    { el: ctec,  depth: 0.5, base: 25,  sy: 1.05, omega: 27 },
    { el: deer,  depth: 0.0, base: 25,  sy: 1.0,  omega: 0 },
    { el: title, depth: 0.25, base: 0,  sy: 1.0,  omega: 64 },
  ].filter((l) => l.el);

  // Estado de inercia por capa (solo omega > 0): pos = "slip" (la separación
  // que la capa mantiene con el desplazamiento del scroll), no la posición
  // final. Al reposo pos = 0 → offset = base, idéntico a hoy. La suavidad es
  // una CASCADA de dos resortes críticamente amortiguados idénticos (orden 4):
  // la etapa interna (ipos/ivel) sigue a slipTarget y la externa (pos/vel)
  // sigue a la interna, lo que convierte el perfil de velocidad de "arranque
  // brusco + frenado largo" en una campana simétrica (acelera, avanza, frena
  // con suavidad) sin rebote ni overshoot.
  for (const l of layers) {
    l.pos = 0;
    l.vel = 0;
    l.ipos = 0;
    l.ivel = 0;
  }

  // Margen extra de seguridad del bleed del cielo (px por encima del tope).
  const SAFETY = 40;

  let progress = 0;
  let heroH = 0;
  let rafId = null;
  let lastT = null;
  let inView = false;

  function measure() {
    heroH = hero ? hero.clientHeight : 0;
  }

  /* Progreso 0 → hero recién asomando por arriba (reposo), 1 → hero ya salió
     entero. Se deriva de la posición real del panel en el viewport, así el
     rango es robusto a layout y proporcional a lo que el ojo recorre. */
  function readProgress() {
    if (!hero || heroH <= 0) return;
    const rect = hero.getBoundingClientRect();
    progress = Math.min(Math.max(-rect.top / heroH, 0), 1);
  }

  function render() {
    // Un solo reloj (progress) para todas las capas: recorridos simultáneos
    // y proporcionales; ninguna capa anima "por su cuenta".
    const delta = progress * heroH;
    for (const l of layers) {
      const target = (l.base ?? 0) + l.depth * delta;
      // omega 0 → la capa se ubica AL INSTANTE en su objetivo (venado y
      // cielo: comportamiento idéntico a hoy). omega > 0 → inercia vía slip:
      // en el instante del scroll la capa se queda CLAVADA al viewport
      // (offset absorbe el avance de la página, slip ≈ 0) y luego se despega
      // hacia su factor real, base − (1 − depth)·delta en pantalla.
      // offset = base + delta − slip, y como screen = −delta + offset,
      // lo que el ojo ve es screen = base − pos.
      const offset = l.omega > 0 ? delta - l.pos + (l.base ?? 0) : target;
      // scaleY compartido (sy): es el bleed estático de cada asset, no parte
      // del movimiento. El título no se estira (sy 1).
      l.el.style.transform = `translate3d(0, ${offset.toFixed(1)}px, 0) scale(1, ${(l.sy ?? 1).toFixed(3)})`;
    }
    if (title) title.style.opacity = String(1 - progress * 0.35);
  }

  function frame(t) {
    // Integración de la inercia en el MISMO bucle rAF existente (sin bucles,
    // listeners ni sistemas duplicados). Resorte CRÍTICAMENTE AMORTIGUADO en
    // su forma analítica cerrada por frame sobre el slip: estable y exacto
    // para cualquier dt (independiente de la tasa de frames). Dos etapas
    // idénticas encadenadas (orden 4): la ante-última evita el arranque
    // brusco y la cola larga de frenado del resorte de 2º orden — la capa
    // aguanta el instante inicial del scroll (resiste, no se arrastra con la
    // página) y luego acelera, desliza y frena con perfil suave hasta su
    // factor real, sin rebote ni overshoot. Al reposo converge a 0. El dt se
    // acota solo por higiene: una pausa del tab no debe arrojar números
    // absurdos.
    const dt = lastT === null ? 0 : Math.min(Math.max((t - lastT) / 1000, 0), 0.05);
    lastT = t;
    const delta = progress * heroH;
    for (const l of layers) {
      if (l.omega <= 0) continue;
      const target = (l.base ?? 0) + l.depth * delta;
      // slipTarget = (1 − depth)·delta: cuánto debe separarse la capa del
      // desplazamiento del scroll. Se deriva del mismo target (intacto).
      const slipTarget = (l.base ?? 0) + delta - target;
      const w = l.omega;
      const decay = Math.exp(-w * dt);
      // Etapa interna: primero "cocina" la demanda (suaviza el arranque).
      let x0 = l.ipos - slipTarget;
      let c = (l.ivel + w * x0) * dt;
      l.ipos = slipTarget + (x0 + c) * decay;
      l.ivel = (l.ivel - w * (l.ivel + w * x0) * dt) * decay;
      // Etapa externa: la visible sigue a la interna (suaviza el frenado).
      x0 = l.pos - l.ipos;
      c = (l.vel + w * x0) * dt;
      l.pos = l.ipos + (x0 + c) * decay;
      l.vel = (l.vel - w * (l.vel + w * x0) * dt) * decay;
    }
    render();
    rafId = requestAnimationFrame(frame);
  }

  function wake() {
    if (rafId === null && inView && !reduceMotion && layers.length > 0) {
      rafId = requestAnimationFrame(frame);
    }
  }

  function sleep() {
    if (rafId !== null) {
      cancelAnimationFrame(rafId);
      rafId = null;
    }
  }

  /* Bleed vertical del cielo: crece desde su base (origen abajo) para que aun
     en su recorrido máximo la escena cubra el panel sin mostrar el azul. El
     área visible de la capa base es un gradiente suave y continuo, así que
     este estirado es imperceptible en el arte. */
  function computeBleed() {
    const h = hero ? hero.clientHeight : 0;
    if (h <= 0) return;
    for (const l of layers) {
      if (l.sy == null) l.sy = 1 + (l.depth * h + SAFETY) / h;
    }
  }

  if (!reduceMotion && layers.length > 0) {
    window.addEventListener(
      'scroll',
      () => {
        readProgress();
        wake();
      },
      { passive: true }
    );

    if ('IntersectionObserver' in window && hero) {
      new IntersectionObserver(
        (entries) => {
          inView = entries.some((entry) => entry.isIntersecting);
          if (inView) {
            wake();
          } else {
            sleep();
          }
        },
        { threshold: 0.25 }
      ).observe(hero);
    } else {
      inView = true;
      wake();
    }

    measure();
    computeBleed();
    readProgress();
    render();

    window.addEventListener(
      'resize',
      () => {
        measure();
        computeBleed();
        readProgress();
        wake();
      },
      { passive: true }
    );
  }
</script>