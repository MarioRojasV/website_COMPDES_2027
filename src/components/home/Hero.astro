---
import { useTranslations } from '../../i18n/ui';

const lang = (Astro.currentLocale as 'es' | 'en') ?? 'es';
const t = useTranslations(lang);
---

<section class="hero" aria-label={t('hero.title')}>
  <div class="hero-art" aria-hidden="true">
    <img class="hero-bg" src={`${import.meta.env.BASE_URL}/fondos/principal_extendido.webp`} alt="" />
    <img id="hero-logo" class="hero-logo" src={`${import.meta.env.BASE_URL}/fondos/volcano.webp`} alt="" />
    <img class="hero-ctec" src={`${import.meta.env.BASE_URL}/fondos/ctec.webp`} alt="" />
    <img class="hero-deer" src={`${import.meta.env.BASE_URL}/fondos/deer.webp`} alt="" />
  </div>

  <!-- Velo inferior de integración: funde la base de la viñeta con el azul
       plano y con la sección siguiente (mismo color, nunca negro). -->
  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="hero-inner">
    <h1 class="hero-title font-mono font-bold" data-i18n="hero.title">
      <span class="block">COMPDES</span>
      <span class="block text-compdes-yellow">2027</span>
    </h1>
  </div>
</section>

<style>
  .hero {
    position: relative;
    /* Altura = la MAYOR entre la ventana completa y el alto que le
       correspondería al ancho completo a proporción 16:9 (la proporción
       real de las 4 imágenes del hero). En pantallas normales o angostas,
       100svh siempre gana y el comportamiento es igual al original
       (altura = ventana). En monitores ultra-wide, donde el ancho es
       desproporcionado respecto al alto, calc(100vw * 9/16) gana y la
       sección crece más alta que la ventana — el usuario hace un poco
       más de scroll para pasarla, pero object-fit:cover ya no tiene que
       agrandar ni recortar la escena, porque en ese punto el contenedor
       queda con la misma proporción 16:9 que la imagen. La navbar
       transparente FLOTA sobre el hero (position:absolute), así que no
       hay que restarle altura. Piso de 560px para pantallas angostas. */
    height: max(100vh, calc(100vw * 9 / 16));
    height: max(100svh, calc(100vw * 9 / 16));
    min-height: 560px;
    overflow: hidden;
    background-color: var(--color-compdes-blue-900);
  }

  /* Contenedor de capas a sangre completa: abarca todo el panel, de borde
     a borde de la página, siempre al 100% del ancho de la ventana (sin
     letterboxing lateral). Las 4 capas dentro son piezas de una misma
     escena con parallax, superpuestas y alineadas entre sí porque todas
     comparten exactamente este mismo tamaño. */
  .hero-art {
    position: absolute;
    inset: 0;
    pointer-events: none;
    user-select: none;
  }

  .hero-bg,
  .hero-logo,
  .hero-ctec,
  .hero-deer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
  }

  .hero-bg,
  .hero-logo,
  .hero-ctec,
  .hero-deer {
    object-position: center 65%;
    transform-origin: center bottom;
  }

  /* Solo las capas animadas declaran will-change; principal queda fija.
     transform-origin abajo: el sangrado por escala (bleed) crece hacia
     ARRIBA, anclando la escena a su base y ocultando el borde superior
     recortado de cada capa aunque el parallax las empuje hacia abajo. */
  .hero-logo,
  .hero-ctec,
  .hero-deer {
    will-change: transform;
  }

  .hero-logo,
  .hero-ctec {
    transform-origin: center bottom;
  }

  /* Profundidad: el título queda UNA CAPA POR DETRÁS del deer (z 2 > 1),
     pero por encima de volcano/ctec/principal (sin z-index). */
  .hero-deer {
    z-index: 2;
  }

  /* Velo inferior de integración: funde la base de TODAS las capas (deer
     incluido, va por encima con z 3) con el azul plano y con la sección
     siguiente — degradado del color del panel, nunca negro. */
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 3;
    background: linear-gradient(to top, var(--color-compdes-blue-900), transparent 25%);
    pointer-events: none;
  }

  .hero-inner {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding: 0 max(1.5rem, 6vw) max(10rem, 46svh) max(3rem, 9vw);
    text-align: left;
    will-change: transform;
  }

  .hero-title {
    color: var(--color-compdes-cream);
    font-size: clamp(2.75rem, 8.75vw, 6.75rem);
    line-height: 1.05;
    letter-spacing: 0;
    /* Sombra suave: difuminados amplios y poca opacidad para separar el
       texto del fondo sin dureza. */
    text-shadow:
      0 2px 14px rgb(0 0 0 / 0.35),
      0 10px 56px rgb(0 0 0 / 0.3);
    will-change: transform, opacity;
  }
</style>

<script>
  const hero = document.querySelector('.hero');
  const bg = document.querySelector('.hero-bg');
  const logo = document.querySelector('#hero-logo');
  const ctec = document.querySelector('.hero-ctec');
  const deer = document.querySelector('.hero-deer');
  const title = document.querySelector('.hero-title');

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Capas con alfa, de fondo a frente: recorrido creciente. `amp` es el
  // desplazamiento total (px) que la capa recorrería de reposo a scroll
  // máximo; como el parallax es DE UN SOLO SENTIDO (solo al bajar, nunca
  // rebota al subir), el desplazamiento real se limita a TRAVEL (abajo) y
  // el sangrado vertical se deriva de ese tope para que el borde superior
  // de ninguna capa pueda quedar expuesto sin fondo azul.
  // `base` es un desplazamiento estático hacia abajo (en px) que se aplica
  // antes del recorrido; oculta bordes inferiores visibles en estado de
  // reposo sin afectar el rango del parallax.
  // NOTA IMPORTANTE: ctec.webp y deer.webp NO son recortes sueltos con
  // fondo transparente — son paneles panorámicos de ancho completo (la
  // colina/rocas ya ocupan casi todo el ancho del archivo), igual que
  // hero-bg, así que ninguna capa lleva `size`: encoger una de ellas con
  // scale() dejaría huecos en los bordes donde se asoma hero-bg. Si el
  // edificio o el venado deben verse más chicos, hay que pedir el asset ya
  // recompuesto más chico dentro del panel, no lograrlo con CSS/JS.
  // Parallax muy sutil con velocidades DIFERENTES por capa: `amp` es el
  // desplazamiento máximo (px) y su valor distinto también modula la
  // velocidad (desplazamiento = progress × amp). Todas las capas vuelven a
  // su posición original al subir el scroll. El venado (deer) NO hace
  // parallax (amp 0): queda fijo en su posición original. El fondo (bg)
  // conserva su sangrado dinámico ("auto", sin `sy`) para cubrir su
  // recorrido sin que asome el azul de la página; el resto conserva su `sy`
  // original (≈1: tamaño auténtico del asset), pues al desplazarse menos
  // sus bordes se asoman sobre la escena del fondo, no sobre el azul.
  const layers = [
    { el: bg,    amp: 280,  omega: 13, zeta: 0.9 }, // sy dinámico "auto"
    { el: logo,  amp: 40,   omega: 13, zeta: 0.9, sy: 1.0 },
    { el: ctec,  amp: 90,   omega: 9,  zeta: 0.9, base: 25, sy: 1.05 },
    { el: deer,  amp: 0,    omega: 0,  zeta: 0,   base: 25, sy: 1.0 },
    { el: title, amp: 60,   omega: 7,  zeta: 0.5, sy: 1.0 },
  ].filter((l) => l.el);

  for (const l of layers) {
    l.pos = 0;
    l.vel = 0;
  }

  let progress = 0;
  let rafId = null;
  let lastT = 0;
  let inView = false;

  function render() {
    for (const l of layers) {
      const offset = (l.base ?? 0) + l.pos;
      // scaleY compartido por igual en todas las capas de escena (así la
      // escena no se descuadra). El título NO se estira (sy 1).
      l.el.style.transform = `translate3d(0, ${offset.toFixed(1)}px, 0) scale(1, ${(l.sy ?? 1).toFixed(3)})`;
    }
    if (title) title.style.opacity = String(1 - progress * 0.35);
  }

  function frame(t) {
    const dt = Math.min(Math.max((t - lastT) / 1000, 0), 1 / 30);
    lastT = t;

    // Parallax SUAVE de seguimiento directo: cada capa se ubica en su
    // desplazamiento (progress * amp) y vuelve a su posición original al
    // subir — sin resorte, sin rebote y sin quedarse desplazada.
    for (const l of layers) {
      const target = progress * l.amp * (l.speed ?? 1);
      const cap = Math.min(l.amp ?? 0, TRAVEL);
      l.pos = Math.min(Math.max(target, 0), cap);
      l.vel = 0;
    }

    render();
    rafId = requestAnimationFrame(frame);
  }

  function wake() {
    if (rafId === null && inView && !reduceMotion && layers.length > 0) {
      lastT = performance.now();
      rafId = requestAnimationFrame(frame);
    }
  }

  function sleep() {
    if (rafId !== null) {
      cancelAnimationFrame(rafId);
      rafId = null;
    }
  }

  function readProgress() {
    if (!hero) return;
    const max = hero.offsetHeight;
    progress = max === 0 ? 0 : Math.min(Math.max(window.scrollY / max, 0), 1);
  }

  // Tope de recorrido del parallax (px). El sangrado vertical dinámico solo
  // se aplica a la capa de fondo (bg): crece desde su base y garantiza que
  // su borde superior quede siempre por encima del panel (SAFETY de sobra)
  // aun en su desplazamiento máximo, así el fondo azul no puede asomarse.
  const TRAVEL = 280;
  const SAFETY = 40;

  function computeBleed() {
    const h = hero ? hero.clientHeight : 0;
    if (h <= 0) return;
    // Solo la capa de fondo (sin `sy` fijo) se estira para cubrir su recorrido.
    for (const l of layers) {
      if (l.sy == null) l.sy = 1 + (TRAVEL + SAFETY) / h;
    }
  }

  if (!reduceMotion && layers.length > 0) {
    window.addEventListener(
      'scroll',
      () => {
        readProgress();
        wake();
      },
      { passive: true }
    );

    if ('IntersectionObserver' in window && hero) {
      new IntersectionObserver(
        (entries) => {
          inView = entries.some((entry) => entry.isIntersecting);
          if (inView) {
            wake();
          } else {
            sleep();
          }
        },
        { threshold: 0.25 }
      ).observe(hero);
    } else {
      inView = true;
      wake();
    }

    computeBleed();
    readProgress();
    render();

    window.addEventListener(
      'resize',
      () => {
        computeBleed();
        readProgress();
        wake();
      },
      { passive: true }
    );
  }
</script>