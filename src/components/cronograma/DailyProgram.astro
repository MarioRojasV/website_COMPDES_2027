---
import SectionHeading from '../ui/SectionHeading.astro';
import LangText from '../ui/LangText.astro';
import { useTranslations } from '../../i18n/ui';
import { scheduleDays, type DayId, type SlotKind } from '../../data/schedule';

const lang = (Astro.currentLocale as 'es' | 'en') ?? 'es';
const t = useTranslations(lang);

/* Color distintivo por día en las pestañas: miércoles electric pink,
   jueves voltage violet, viernes acid lime. */
const DAY_THEME: Record<DayId, { hover: string; selected: string }> = {
  miercoles: {
    hover: 'hover:border-compdes-pink',
    selected: 'aria-selected:border-compdes-pink aria-selected:bg-compdes-pink',
  },
  jueves: {
    hover: 'hover:border-compdes-violet',
    selected: 'aria-selected:border-compdes-violet aria-selected:bg-compdes-violet',
  },
  viernes: {
    hover: 'hover:border-compdes-lime',
    selected: 'aria-selected:border-compdes-lime aria-selected:bg-compdes-lime',
  },
};

/* Estilo del chip por tipo de bloque: la magistral va sólida, las pausas
   quedan como texto tenue sin chip para no saturar la línea de tiempo. */
const KIND_CHIP: Record<SlotKind, string> = {
  keynote: 'border-compdes-yellow bg-compdes-yellow text-compdes-blue',
  session: 'border-compdes-yellow/60 text-compdes-yellow',
  workshop: 'border-compdes-cream/50 text-compdes-cream',
  ceremony: 'border-compdes-yellow/60 text-compdes-yellow',
  activity: 'border-compdes-cream/40 text-compdes-cream/80',
  break: '',
  lunch: '',
};

const isQuiet = (kind: SlotKind) => kind === 'break' || kind === 'lunch';
---

<!-- [ sec.02 ] Programa por día — pestañas + terminal con bloques horarios -->
<section id="programa" class="border-y-2 border-compdes-yellow bg-compdes-blue py-16 text-compdes-cream md:py-24">
  <div class="mx-auto max-w-4xl px-6">
    <SectionHeading
      sectionNumber={2}
      eyebrowKey="cron.program.eyebrow"
      titleKey="cron.program.title"
      introKey="cron.program.intro"
      align="center"
      dark
    />

    <div class="mt-12 md:mt-16" data-day-tabs>
      <!-- Pestañas -->
      <div
        role="tablist"
        aria-label={t('cron.program.tabsAria')}
        class="flex flex-wrap justify-center gap-2"
      >
        {
          scheduleDays.map((day, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${day.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`panel-${day.id}`}
              data-day-tab={day.id}
              class:list={[
                'cursor-pointer border-2 border-compdes-blue-600 bg-compdes-blue px-5 py-2.5 text-left transition-colors duration-300 aria-selected:text-compdes-blue',
                DAY_THEME[day.id].hover,
                DAY_THEME[day.id].selected,
              ]}
            >
              <span class="block font-mono text-xs font-bold uppercase tracking-[0.18em]">
                <LangText value={day.label} />
              </span>
              <span class="mt-0.5 block font-mono text-[10px] tracking-wide opacity-70">
                <LangText value={day.date} />
              </span>
            </button>
          ))
        }
      </div>

      <!-- Paneles -->
      {
        scheduleDays.map((day, i) => (
          <div
            role="tabpanel"
            id={`panel-${day.id}`}
            aria-labelledby={`tab-${day.id}`}
            data-day-panel={day.id}
            hidden={i !== 0}
            class="mt-6"
          >
            <div class="terminal-window corner mx-auto max-w-3xl">
              <div class="term-titlebar">
                <span class="term-dots"><i></i><i></i><i></i></span>
                <span>
                  [<LangText value={day.label} /> · <LangText value={day.date} />]
                </span>
                <span class="hidden sm:inline">agenda.exe</span>
              </div>

              <ul class="divide-y divide-dashed divide-compdes-blue-600">
                {day.slots.map((slot) => (
                  <li class="grid grid-cols-[86px_1fr] items-baseline gap-x-4 gap-y-1 px-6 py-3.5 sm:grid-cols-[120px_1fr_auto] sm:items-center">
                    <p class="font-mono text-xs tabular-nums text-compdes-cream/55">
                      {slot.start}–{slot.end}
                    </p>

                    <p
                      class:list={[
                        'text-sm leading-snug',
                        isQuiet(slot.kind)
                          ? 'italic text-compdes-cream/50'
                          : 'font-medium text-compdes-cream',
                      ]}
                    >
                      <LangText value={slot.title} />
                    </p>

                    {slot.kind in KIND_CHIP && KIND_CHIP[slot.kind] ? (
                      <p
                        class:list={[
                          'justify-self-start border px-2 py-0.5 font-mono text-[9px] uppercase tracking-[0.18em] sm:justify-self-end',
                          KIND_CHIP[slot.kind],
                        ]}
                      >
                        <span data-i18n={`cron.kind.${slot.kind}`}>{t(`cron.kind.${slot.kind}`)}</span>
                      </p>
                    ) : (
                      <p class="hidden font-mono text-[10px] uppercase tracking-[0.18em] text-compdes-cream/40 sm:block sm:justify-self-end">
                        <span data-i18n={`cron.kind.${slot.kind}`}>{t(`cron.kind.${slot.kind}`)}</span>
                      </p>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Pestañas accesibles: un clic activa el día; sin JS todos los paneles
  // quedan apilados y visibles (mejora progresiva).
  document.querySelectorAll<HTMLElement>('[data-day-tabs]').forEach((wrap) => {
    const tabs = Array.from(wrap.querySelectorAll<HTMLButtonElement>('[data-day-tab]'));
    const panels = Array.from(wrap.querySelectorAll<HTMLElement>('[data-day-panel]'));
    if (!tabs.length || !panels.length) return;

    const activate = (id: string) => {
      tabs.forEach((tab) =>
        tab.setAttribute('aria-selected', String(tab.dataset.dayTab === id)),
      );
      panels.forEach((panel) =>
        panel.toggleAttribute('hidden', panel.dataset.dayPanel !== id),
      );
    };

    activate(tabs[0].dataset.dayTab as string);
    tabs.forEach((tab) =>
      tab.addEventListener('click', () => activate(tab.dataset.dayTab as string)),
    );
  });
</script>
