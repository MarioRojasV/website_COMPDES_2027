---
import PageHeader from '../PageHeader.astro';
import LangText from '../ui/LangText.astro';
import { cfp, cfpLinks } from '../../data/cfp';
import fondoGarza from '../../assets/images/headers/fondo-garza.webp';
import garza from '../../assets/images/headers/garza.webp';

const modalities = [cfp.technical, cfp.posters];
const posterSpecs = [
  [cfp.posterPresentation.sizeLabel, cfp.posterPresentation.size],
  [cfp.posterPresentation.productionLabel, cfp.posterPresentation.production],
  [cfp.posterPresentation.designLabel, cfp.posterPresentation.design],
  [cfp.posterPresentation.identityLabel, cfp.posterPresentation.identity],
  [cfp.posterPresentation.languageLabel, cfp.posterPresentation.language],
  [cfp.posterPresentation.printingLabel, cfp.posterPresentation.printing],
];
---

<PageHeader titleKey="nav.cfp" tagKey="pageheader.tag.cfp" descKey="pageheader.desc.cfp" index="03" placeholder={false} artBgSrc={fondoGarza} artBirdSrc={garza} artEntrance="right" artMotion="drift" artPlacement="aligned" artStillBg />

<div class="bg-compdes-blue-800 text-compdes-cream">
  <div class="mx-auto max-w-6xl px-6 py-12 md:py-20">
    <div class="grid gap-8 border-l-4 border-compdes-yellow pl-5 md:grid-cols-[1fr_1fr] md:gap-12 md:pl-8">
      <p class="text-lg font-semibold leading-relaxed md:text-xl"><LangText value={cfp.intro} /></p>
      <p class="text-sm leading-relaxed md:text-base"><LangText value={cfp.introReview} /></p>
    </div>

    <section aria-labelledby="cfp-dates" class="mt-16 md:mt-24">
      <h2 id="cfp-dates" class="section-title"><span class="section-mark">01 /</span> <LangText value={cfp.datesTitle} /></h2>
      <div class="mt-7 grid gap-4 md:grid-cols-3">
        {cfp.dates.map((date, i) => (
          <article class="border-t-4 border-compdes-yellow bg-compdes-blue-700 p-6 text-compdes-cream shadow-[5px_5px_0_0_var(--color-compdes-blue-900)]">
            <span class="text-xs font-bold text-compdes-yellow-400">0{i + 1} // {date.year}</span>
            <div class="mt-3 flex items-baseline gap-3" aria-hidden="true"><span class="text-4xl font-bold">{date.day}</span><span class="text-lg text-compdes-yellow"><LangText value={date.month} /></span></div>
            <p class="mt-1 text-xs text-compdes-cream/75"><LangText value={date.full} /></p>
            <p class="mt-4 border-t border-compdes-cream/25 pt-4 text-sm leading-relaxed"><LangText value={date.label} /></p>
          </article>
        ))}
      </div>
    </section>

    <section aria-labelledby="cfp-guidelines" class="mt-20 md:mt-28">
      <h2 id="cfp-guidelines" class="section-title"><span class="section-mark">02 /</span> <LangText value={cfp.guidelines} /></h2>
      <div class="mt-8 grid items-start gap-7 lg:grid-cols-2">
        {modalities.map((modality, i) => (
          <article class="min-w-0 border border-compdes-cream/20 bg-compdes-blue-700 shadow-[6px_6px_0_0_var(--color-compdes-blue-900)]">
            <div class="bg-compdes-blue px-6 py-6 text-compdes-cream">
              <span class="text-xs font-bold text-compdes-yellow-400">0{i + 1} // COMPDES 2027</span>
              <h3 class="mt-2 text-2xl font-bold"><LangText value={modality.title} /></h3>
            </div>
            <div class="space-y-4 px-6 py-7 text-sm leading-relaxed">
              {'document' in modality ? (
                <>{modality.intro.map((p) => <p><LangText value={p} /></p>)}<p class="font-semibold"><LangText value={modality.document} /></p></>
              ) : <p><LangText value={modality.intro} /></p>}
              <h4 class="pt-3 text-base font-bold"><LangText value={modality.requirements} /></h4>
              <div class="border-l-2 border-compdes-yellow pl-4"><h5 class="font-bold"><LangText value={cfp.labels.language} /></h5><p class="mt-1"><LangText value={modality.length} /></p></div>
              <div class="border-l-2 border-compdes-yellow pl-4">
                <h5 class="font-bold"><LangText value={cfp.labels.format} /></h5>
                <p class="mt-1"><LangText value={modality.format} /></p>
                <div class="mt-3 flex flex-wrap gap-x-5 gap-y-2">
                  <a class="resource-link" href={cfpLinks.ieee} target="_blank" rel="noopener noreferrer"><LangText value={cfp.labels.templates} /> ↗</a>
                  <a class="resource-link" href={cfpLinks.overleaf} target="_blank" rel="noopener noreferrer"><LangText value={cfp.labels.overleaf} /> ↗</a>
                </div>
              </div>
              <details class="border border-compdes-cream/20 bg-compdes-blue-900 p-4 open:border-compdes-yellow/60">
                <summary class="cursor-pointer font-bold marker:text-compdes-yellow"><LangText value={cfp.labels.details} /></summary>
                <div class="mt-5 space-y-5">
                  {'content' in modality && <div><h5 class="font-bold"><LangText value={cfp.labels.content} /></h5>{modality.content.map((p) => <p class="mt-2"><LangText value={p} /></p>)}</div>}
                  <div><h5 class="font-bold"><LangText value={cfp.labels.review} /></h5><p class="mt-2"><LangText value={modality.review} /></p></div>
                  <div><h5 class="font-bold"><LangText value={cfp.labels.anonymity} /></h5>{modality.anonymity.map((p) => <p class="mt-2"><LangText value={p} /></p>)}</div>
                  <div><h5 class="font-bold"><LangText value={cfp.labels.ai} /></h5><p class="mt-2"><LangText value={cfp.ai.before} /> <a class="resource-link" href={cfpLinks.policy} target="_blank" rel="noopener noreferrer"><LangText value={cfp.labels.policy} /> ↗</a>.</p><p class="mt-2"><LangText value={cfp.ai.after} /></p></div>
                </div>
              </details>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section aria-labelledby="cfp-poster" class="mt-20 md:mt-28">
      <h2 id="cfp-poster" class="section-title"><span class="section-mark">03 /</span> <LangText value={cfp.posterPresentation.title} /></h2>
      <p class="mt-4 max-w-3xl text-sm leading-relaxed"><LangText value={cfp.posterPresentation.intro} /></p>
      <div class="mt-7 grid gap-4 md:grid-cols-2">
        <div class="border border-compdes-cream/20 bg-compdes-blue-700 p-6 md:col-span-2"><h3 class="font-bold"><LangText value={cfp.labels.content} /></h3><p class="mt-2 text-sm leading-relaxed"><LangText value={cfp.posterPresentation.contentIntro} /></p><ul class="mt-4 grid gap-2 text-sm sm:grid-cols-2">{cfp.posterPresentation.items.map((item) => <li class="flex gap-2"><span aria-hidden="true" class="text-compdes-yellow">▸</span><LangText value={item} /></li>)}</ul></div>
        {posterSpecs.map(([label, value]) => <div class="border-l-4 border-compdes-yellow bg-compdes-blue-700 p-5"><h3 class="font-bold"><LangText value={label} /></h3><p class="mt-2 text-sm leading-relaxed"><LangText value={value} /></p></div>)}
      </div>
    </section>

    <div class="mt-20 grid gap-10 md:mt-28 lg:grid-cols-2 lg:gap-12">
      <section aria-labelledby="cfp-attendance">
        <h2 id="cfp-attendance" class="section-title"><span class="section-mark">04 /</span> <LangText value={cfp.attendance.title} /></h2>
        <ul class="mt-6 space-y-4 text-sm leading-relaxed">{cfp.attendance.items.map((item) => <li class="border-l-2 border-compdes-yellow pl-4"><LangText value={item} /></li>)}</ul>
      </section>
      <section aria-labelledby="cfp-publication">
        <h2 id="cfp-publication" class="section-title"><span class="section-mark">05 /</span> <LangText value={cfp.publication.title} /></h2>
        <div class="mt-6 space-y-4 text-sm leading-relaxed">
          <p><LangText value={cfp.publication.technical} /></p><p><LangText value={cfp.publication.posters} /></p>
          <p class="font-bold"><LangText value={cfp.publication.conditions} /></p>
          <ol class="list-decimal space-y-3 pl-6 marker:font-bold marker:text-compdes-yellow">{cfp.publication.requirements.map((item) => <li class="pl-1"><LangText value={item} /></li>)}</ol>
          <p><LangText value={cfp.publication.multiple} /></p><p><LangText value={cfp.publication.indexing} /></p>
          <p class="border-l-4 border-compdes-yellow bg-compdes-blue-700 p-5 font-semibold"><LangText value={cfp.publication.caveat} /></p>
        </div>
      </section>
    </div>
  </div>

  <section aria-labelledby="cfp-submit" class="border-y-2 border-compdes-yellow bg-compdes-blue-900 py-16 text-compdes-cream md:py-20">
    <div class="mx-auto max-w-5xl px-6">
      <span class="text-xs font-bold text-compdes-yellow-400">[ 06 / COMPDES 2027 ]</span>
      <h2 id="cfp-submit" class="mt-3 text-3xl font-bold md:text-4xl"><LangText value={cfp.submission.title} /></h2>
      <p class="mt-4 max-w-2xl text-sm leading-relaxed"><LangText value={cfp.submission.intro} /></p>
      <a class="mt-7 inline-flex max-w-full items-center border-2 border-compdes-yellow bg-compdes-yellow px-5 py-4 font-bold text-compdes-blue transition-colors hover:bg-compdes-yellow-400 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-compdes-yellow" href={cfpLinks.submit} target="_blank" rel="noopener noreferrer"><LangText value={cfp.submission.button} /></a>
      <p class="mt-4 break-all text-xs text-compdes-cream/75">{cfpLinks.submit}</p>
    </div>
  </section>

  <div class="mx-auto max-w-5xl px-6 py-14 md:py-20">
    <section aria-labelledby="cfp-authors">
      <h2 id="cfp-authors" class="section-title"><LangText value={cfp.authors.title} /></h2>
      <p class="mt-4 max-w-3xl text-sm leading-relaxed"><LangText value={cfp.authors.intro} /></p>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        <a class="block min-w-0 border border-compdes-cream/25 bg-compdes-blue-700 p-5 transition-colors hover:border-compdes-yellow focus-visible:outline-2 focus-visible:outline-compdes-yellow" href={cfpLinks.account} target="_blank" rel="noopener noreferrer"><span class="block font-bold"><LangText value={cfp.authors.account} /> ↗</span><span class="mt-2 block break-all text-xs text-compdes-cream/75">{cfpLinks.account}</span></a>
        <a class="block min-w-0 border border-compdes-cream/25 bg-compdes-blue-700 p-5 transition-colors hover:border-compdes-yellow focus-visible:outline-2 focus-visible:outline-compdes-yellow" href={cfpLinks.guide} target="_blank" rel="noopener noreferrer"><span class="block font-bold"><LangText value={cfp.authors.guide} /> ↗</span><span class="mt-2 block break-all text-xs text-compdes-cream/75">{cfpLinks.guide}</span></a>
      </div>
    </section>
    <aside class="mt-16 border-t border-compdes-cream/25 pt-8 text-sm leading-relaxed">
      <h2 class="font-bold"><LangText value={cfp.acknowledgment.title} /></h2>
      <p class="mt-3 max-w-4xl"><LangText value={cfp.acknowledgment.text} /></p>
    </aside>
  </div>
</div>

<style>
  .section-title { font-size: clamp(1.35rem, 3vw, 1.85rem); font-weight: 700; line-height: 1.3; }
  .section-mark { color: var(--color-compdes-yellow-400); font-size: .8rem; font-weight: 700; white-space: nowrap; }
  .resource-link { color: var(--color-compdes-cream); text-decoration: underline; text-decoration-color: var(--color-compdes-yellow-400); text-underline-offset: 3px; font-weight: 700; }
  .resource-link:hover { color: var(--color-compdes-yellow-400); }
  .resource-link:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
</style>
