---
import { useTranslations, localizedUrl } from '../i18n/ui';

export interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const links: { href: string; key: 'nav.home' | 'nav.inscripcion' | 'nav.areas' | 'nav.cronograma' | 'nav.hospedaje' | 'nav.turismo' | 'nav.organizacion' | 'nav.patrocinadores' }[] = [
  { href: '/', key: 'nav.home' },
  { href: '/inscripcion-participacion', key: 'nav.inscripcion' },
  { href: '/areas-interes', key: 'nav.areas' },
  { href: '/cronograma', key: 'nav.cronograma' },
  { href: '/hospedaje', key: 'nav.hospedaje' },
  { href: '/turismo', key: 'nav.turismo' },
  { href: '/organizacion', key: 'nav.organizacion' },
  { href: '/patrocinadores', key: 'nav.patrocinadores' },
];
---

<footer class="mt-auto border-t-4 border-compdes-yellow bg-compdes-blue text-compdes-cream">
  <div class="mx-auto max-w-6xl px-6 py-10">
    <div class="grid gap-10 md:grid-cols-3">
      <div>
        <p class="font-mono text-lg font-bold">
          <span class="text-compdes-yellow">&gt;_</span>
          COMPDES_<span class="text-compdes-yellow">2027</span>
        </p>
        <p class="mt-3 text-sm leading-relaxed text-compdes-cream/70" data-i18n="footer.tagline">
          {t('footer.tagline')}
        </p>
      </div>

      <div>
        <p class="text-[11px] uppercase tracking-[0.25em] text-compdes-yellow">[ navegación ]</p>
        <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2 text-sm text-compdes-cream/80">
          {links.map((link) => (
            <li>
              <a href={localizedUrl(link.href, lang)} class="transition-colors hover:text-compdes-yellow">
                {t(link.key)}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <p class="text-[11px] uppercase tracking-[0.25em] text-compdes-yellow">[ contacto ]</p>
        <ul class="mt-4 space-y-2 text-sm text-compdes-cream/80">
          <!-- <li>compdes2027@example.com</li>
          <li>+51 999 999 999</li>
          <li>@compdes2027 · fb / x / ig</li> -->
        </ul>
      </div>
    </div>

    <div
      class="mt-10 flex flex-col justify-between gap-2 border-t border-dashed border-compdes-cream/30 pt-5 text-xs text-compdes-cream/60 sm:flex-row"
    >
      <p data-i18n="footer.copyright">{t('footer.copyright')}</p>
      <p>// fin de transmisión<span class="blink">_</span></p>
    </div>
  </div>
</footer>