---
import LangToggle from '../i18n/LangToggle.astro';
import { useTranslations, localizedUrl } from '../i18n/ui';

export interface Props {
  currentPath: string;
  lang: 'es' | 'en';
  transparent?: boolean;
}

const { currentPath, lang, transparent = false } = Astro.props;
const t = useTranslations(lang);

const links: { href: string; key: 'nav.home' | 'nav.inscripcion' | 'nav.preinscripcion' | 'nav.areas' | 'nav.cronograma' | 'nav.hospedaje' | 'nav.turismo' | 'nav.organizacion' | 'nav.patrocinadores' }[] = [
  { href: '/', key: 'nav.home' },
  { href: '/inscripcion-participacion', key: 'nav.inscripcion' },
  { href: '/pre-inscripcion', key: 'nav.preinscripcion' },
  { href: '/areas-interes', key: 'nav.areas' },
  { href: '/cronograma', key: 'nav.cronograma' },
  { href: '/hospedaje', key: 'nav.hospedaje' },
  { href: '/turismo', key: 'nav.turismo' },
  { href: '/organizacion', key: 'nav.organizacion' },
  { href: '/patrocinadores', key: 'nav.patrocinadores' },
];
---

<nav
  class:list={[
    'site-nav sticky top-0 z-50 border-b-2 text-compdes-cream transition-colors duration-300',
    transparent ? 'site-nav--transparent' : 'border-compdes-yellow bg-compdes-blue',
  ]}
  aria-label={t('common.navAria')}
>
  <div
    class:list={[
      'site-nav__topbar hidden border-b sm:block transition-colors duration-300',
      transparent ? 'border-transparent' : 'border-compdes-cream/20 bg-compdes-blue-900',
    ]}
  >
    <div
      class="mx-auto flex max-w-6xl items-center justify-between px-6 py-1 text-[11px] uppercase tracking-[0.25em] text-compdes-cream/70"
    >
      <span>compdes_2027 // sistema en línea</span>
      <span class="hidden items-center gap-2 sm:flex">
        <i class="status-led"></i>
        sync&nbsp;ok
      </span>
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-6">
    <div class="flex items-center justify-between gap-6 py-4">
      <a href={localizedUrl('/', lang)} class="flex items-center gap-2 font-display text-lg font-bold">
        <span class="text-compdes-yellow">&gt;_</span>
        COMPDES_<span class="text-compdes-yellow">2027</span>
      </a>

      <div class="flex items-center gap-3 lg:hidden">
        <LangToggle lang={lang} />
        <button
          id="menu-btn"
          type="button"
          aria-label={t('common.openMenu')}
          aria-expanded="false"
          aria-controls="menu"
          class="rounded border border-compdes-cream/40 px-3 py-1.5 text-lg text-compdes-yellow"
        >
          [≡]
        </button>
      </div>

      <ul
        id="menu"
        class="hidden w-full flex-col gap-y-1 pb-4 lg:flex lg:w-auto lg:flex-row lg:flex-wrap lg:items-center lg:gap-x-5 lg:gap-y-0 lg:pb-0"
      >
        {links.map((link, i) => {
          const href = localizedUrl(link.href, lang);
          const isActive = currentPath === href;
          return (
            <li class="w-full lg:w-auto">
              <a
                href={href}
                aria-current={isActive ? 'page' : undefined}
                data-i18n={link.key}
                class:list={[
                  'flex w-full items-baseline gap-1.5 rounded px-1 py-2 text-xs leading-relaxed transition-colors lg:inline-flex lg:w-auto lg:px-0 lg:py-0',
                  isActive
                    ? 'text-compdes-yellow'
                    : 'text-compdes-cream/80 hover:text-compdes-yellow',
                ]}
              >
                <span class="text-[10px] text-compdes-yellow/80">
                  {String(i + 1).padStart(2, '0')}.
                </span>
                <span
                  class:list={[
                    isActive
                      ? 'border-b border-compdes-yellow pb-0.5'
                      : 'border-b border-transparent pb-0.5',
                  ]}
                >
                  {t(link.key)}
                </span>
              </a>
            </li>
          );
        })}
        <li class="mt-2 w-full lg:mt-0 lg:hidden">
          <LangToggle lang={lang} />
        </li>
        <li class="hidden lg:block">
          <LangToggle lang={lang} />
        </li>
      </ul>
    </div>
  </div>
</nav>

<style>
  /* Out of document flow: floats OVER the hero instead of pushing it down. */
  .site-nav--transparent {
    position: absolute;
    inset: 0 0 auto 0;
    background-color: transparent;
    border-bottom-color: transparent;
  }

  /* Once scrolled past the hero: back into fixed positioning, solid background. */
  .site-nav--transparent.is-scrolled {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    background-color: var(--color-compdes-blue);
    border-bottom-color: var(--color-compdes-yellow);
  }

  .site-nav--transparent.is-scrolled .site-nav__topbar {
    background-color: var(--color-compdes-blue-900);
    border-color: rgb(246 241 231 / 0.2);
  }

  /* While the mobile menu is open, force a solid + fixed navbar even before
     scrolling, so links stay legible and reachable over the hero image. */
  .site-nav--transparent:has(#menu:not(.hidden)) {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    background-color: var(--color-compdes-blue);
    border-bottom-color: var(--color-compdes-yellow);
  }
</style>

<script>
  const nav = document.querySelector('.site-nav');
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('menu');

  btn?.addEventListener('click', () => {
    const isHidden = menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    menu?.classList.toggle('flex', isHidden);
    btn?.setAttribute('aria-expanded', String(isHidden));
  });

  // Transparent (home) navbar: switch to solid background once the hero has
  // fully scrolled out of view (not just a few pixels), so the links stay
  // readable over the hero image for as long as it's on screen.
  if (nav?.classList.contains('site-nav--transparent')) {
    const hero = document.querySelector('.hero');

    if (hero && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        ([entry]) => {
          nav.classList.toggle('is-scrolled', !entry.isIntersecting);
        },
        { threshold: 0 },
      );
      observer.observe(hero);
    } else {
      // Fallback for browsers without IntersectionObserver, or if the hero
      // section isn't found for some reason.
      const onScroll = () => {
        nav.classList.toggle('is-scrolled', window.scrollY > 60);
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    }
  }
</script>