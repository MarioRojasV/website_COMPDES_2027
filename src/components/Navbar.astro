---
import { Image } from 'astro:assets';
import LangToggle from '../i18n/LangToggle.astro';
import { useTranslations, localizedUrl } from '../i18n/ui';
import logo from '../assets/logo/logo.webp';

export interface Props {
  currentPath: string;
  lang: 'es' | 'en';
  transparent?: boolean;
}

const { currentPath, lang, transparent = false } = Astro.props;
const t = useTranslations(lang);

/* El pathname en build/preview llega con barra final ("/cronograma/", "/en/")
   por el formato de directorios; en dev llega sin ella. Normalizar ambos
   lados hace que el resaltado funcione igual en los tres entornos. */
const normalizePath = (path: string) =>
  path.length > 1 && path.endsWith('/') ? path.slice(0, -1) : path;

const links: { href: string; key: 'nav.home' | 'nav.inscripcion' | 'nav.areas' | 'nav.cronograma' | 'nav.hospedaje' | 'nav.turismo' | 'nav.organizacion' | 'nav.patrocinadores' }[] = [
  { href: '/', key: 'nav.home' },
  { href: '/inscripcion-participacion', key: 'nav.inscripcion' },
  { href: '/areas-interes', key: 'nav.areas' },
  { href: '/cronograma', key: 'nav.cronograma' },
  { href: '/hospedaje', key: 'nav.hospedaje' },
  { href: '/turismo', key: 'nav.turismo' },
  { href: '/organizacion', key: 'nav.organizacion' },
  { href: '/patrocinadores', key: 'nav.patrocinadores' },
];
---

<nav
  class:list={[
    'site-nav sticky top-0 z-50 border-b-2 text-compdes-cream transition-colors duration-300',
    transparent ? 'site-nav--transparent' : 'border-compdes-yellow bg-compdes-blue',
  ]}
  aria-label={t('common.navAria')}
>
  <div
    class:list={[
      'site-nav__topbar hidden border-b sm:block transition-colors duration-300',
      transparent ? 'border-transparent' : 'border-compdes-cream/20 bg-compdes-blue-900',
    ]}
  >
    <div
      class="flex items-center justify-between px-6 py-1 text-[11px] uppercase tracking-[0.25em] text-compdes-cream/70 lg:px-10"
    >
      <span>compdes_2027 // sistema en línea</span>
      <span class="hidden items-center gap-2 sm:flex">
        <i class="status-led"></i>
        sync&nbsp;ok
      </span>
    </div>
  </div>

  <div class="px-6 lg:px-10">
    <!-- flex-wrap: con el menú abierto (< xl), la ul w-full salta a su propia
        línea debajo de la marca en vez de exprimirse junto a logo y botones. -->
    <div class="flex flex-wrap items-center justify-between gap-3 py-4 xl:justify-start xl:gap-8">
      <a
        href={localizedUrl('/', lang)}
        class="flex shrink-0 items-center gap-2 font-mono text-lg font-bold"
      >
        <Image src={logo} alt="" height={72} loading="eager" class="h-8 w-auto xl:h-9" />
        {/* El texto vive en un solo span: como items flex separados, el gap-2
            del enlace metía un hueco entre "COMPDES_" y "2027". */}
        <span>
          COMPDES_<span class="text-compdes-yellow">2027</span>
        </span>
      </a>

      <div class="flex shrink-0 items-center gap-3 xl:hidden">
        <LangToggle lang={lang} />
        <button
          id="menu-btn"
          type="button"
          aria-label={t('common.openMenu')}
          aria-expanded="false"
          aria-controls="menu"
          class="rounded border border-compdes-cream/40 px-3 py-1.5 text-lg text-compdes-yellow"
        >
          [≡]
        </button>
      </div>

      <ul
        id="menu"
        class="hidden w-full basis-full flex-col gap-y-1 border-t border-compdes-cream/10 pt-3 pb-4 xl:flex xl:w-auto xl:basis-auto xl:flex-row xl:items-center xl:gap-x-4 xl:border-t-0 xl:pt-0 xl:pb-0"
      >
        {links.map((link, i) => {
          const href = localizedUrl(link.href, lang);
          const isActive = normalizePath(currentPath) === normalizePath(href);
          return (
            <li class="w-full xl:w-auto">
              <a
                href={href}
                aria-current={isActive ? 'page' : undefined}
                data-i18n={link.key}
                class:list={[
                  'flex w-full items-baseline gap-1.5 rounded px-1 py-2.5 text-xs leading-relaxed transition-colors xl:inline-flex xl:w-auto xl:whitespace-nowrap xl:px-0 xl:py-0',
                  isActive
                    ? 'text-compdes-yellow'
                    : 'text-compdes-cream/80 hover:text-compdes-yellow',
                ]}
              >
                <span class="text-[10px] text-compdes-yellow/80 xl:hidden">
                  {String(i + 1).padStart(2, '0')}.
                </span>
                <span
                  class:list={[
                    isActive
                      ? 'border-b border-compdes-yellow pb-0.5'
                      : 'border-b border-transparent pb-0.5',
                  ]}
                >
                  {t(link.key)}
                </span>
              </a>
            </li>
          );
        })}
        <li class="hidden xl:block">
          <LangToggle lang={lang} />
        </li>
      </ul>
    </div>
  </div>
</nav>

<style>
  /* Out of document flow: floats OVER the hero instead of pushing it down.
     `fixed` (not `absolute`) so the navbar stays pinned and static for the
     whole scroll instead of sliding away with the hero on the way down. */
  .site-nav--transparent {
    position: fixed;
    inset: 0 0 auto 0;
    background-color: transparent;
    border-bottom-color: transparent;
  }

  /* Past the hero: same pinned position, only the background goes solid. */
  .site-nav--transparent.is-scrolled {
    background-color: var(--color-compdes-blue);
    border-bottom-color: var(--color-compdes-yellow);
  }

  .site-nav--transparent.is-scrolled .site-nav__topbar {
    background-color: var(--color-compdes-blue-900);
    border-color: rgb(246 241 231 / 0.2);
  }

  /* While the mobile menu is open, force a solid background so links stay
     legible over the hero image. */
  .site-nav--transparent:has(#menu:not(.hidden)) {
    background-color: var(--color-compdes-blue);
    border-bottom-color: var(--color-compdes-yellow);
  }
</style>

<script>
  const nav = document.querySelector('.site-nav');
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('menu');

  btn?.addEventListener('click', () => {
    const isHidden = menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    menu?.classList.toggle('flex', isHidden);
    btn?.setAttribute('aria-expanded', String(isHidden));
  });

  // Transparent (home) navbar: it is always `fixed` (see the CSS above), so the
  // only thing this toggles is the background — transparent over the hero,
  // solid once the hero has fully scrolled out of view, which keeps the links
  // readable over the hero image while it's on screen.
  if (nav?.classList.contains('site-nav--transparent')) {
    const hero = document.querySelector('.hero');

    if (hero && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        ([entry]) => {
          nav.classList.toggle('is-scrolled', !entry.isIntersecting);
        },
        { threshold: 0 },
      );
      observer.observe(hero);
    } else {
      // Fallback for browsers without IntersectionObserver, or if the hero
      // section isn't found for some reason.
      const onScroll = () => {
        nav.classList.toggle('is-scrolled', window.scrollY > 60);
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    }
  }
</script>