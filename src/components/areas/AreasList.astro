---
import SectionHeading from '../ui/SectionHeading.astro';
import LangText from '../ui/LangText.astro';
import { useTranslations } from '../../i18n/ui';
import type { UiKey } from '../../i18n/ui';
import { areaTracks, generalFields, type AreaIcon } from '../../data/areas';

const lang = (Astro.currentLocale as 'es' | 'en') ?? 'es';
const t = useTranslations(lang);

/* Iconos de línea (lucide-style) por tipo de área. */
const ICONS: Record<AreaIcon, string> = {
  cpu: '<rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M15 2v2M15 20v2M9 2v2M9 20v2M2 15h2M2 9h2M20 15h2M20 9h2"/>',
  landmark:
    '<line x1="3" x2="21" y1="22" y2="22"/><line x1="6" x2="6" y1="18" y2="11"/><line x1="10" x2="10" y1="18" y2="11"/><line x1="14" x2="14" y1="18" y2="11"/><line x1="18" x2="18" y1="18" y2="11"/><polygon points="12 2 20 7 4 7"/>',
  languages:
    '<path d="m5 8 6 6M4 14l6-6 2-3M2 5h12M7 2h1M22 22l-5-10-5 10M14 18h6"/>',
  heart:
    '<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>',
  sprout:
    '<path d="M7 20h10"/><path d="M10 20c5.5-2.5.8-6.4 3-10"/><path d="M9.5 9.4c1.1.8 1.8 2.2 2.3 3.7-2 .4-3.5.4-4.8-.3-1.2-.6-2.3-1.9-3-4.2 2.8-.5 4.4 0 5.5.8z"/><path d="M14.1 6a7 7 0 0 0-1.1 4c1.9-.1 3.3-.6 4.3-1.4 1-1 1.6-2.3 1.7-4.6-2.7.1-4 1-4.9 2z"/>',
  city:
    '<path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4M10 10h4M10 14h4M10 18h4"/>',
  shield:
    '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>',
  antenna:
    '<path d="M4.9 16.1C1 12.2 1 5.8 4.9 1.9"/><path d="M7.8 4.7a6.14 6.14 0 0 0-.8 7.5"/><circle cx="12" cy="9" r="2"/><path d="M16.2 4.8c2 2 2.26 5.11.8 7.47"/><path d="M19.1 1.9a9.96 9.96 0 0 1 0 14.1"/><path d="M9.5 18h5"/><path d="m8 22 4-11 4 11"/>',
};

const pad = (n: number) => String(n).padStart(2, '0');
const topicCount = areaTracks.reduce((acc, tr) => acc + tr.groups.reduce((a, g) => a + g.items.length, 0), 0);
---

<!-- [ sec.01 ] Áreas generales — nube de campos clásicos del congreso -->
<section id="areas-generales" class="bg-compdes-blue py-16 text-compdes-cream md:py-24">
  <div class="mx-auto max-w-5xl px-6">
    <SectionHeading
      sectionNumber={1}
      eyebrowKey="nav.areas"
      titleKey="areas.general.title"
      introKey="areas.general.intro"
      align="center"
      dark
    />

    <ul class="mx-auto mt-10 flex max-w-3xl flex-wrap justify-center gap-2.5 md:mt-14">
      {
        generalFields.map((field) => (
          <li>
            <span
              class="inline-flex items-center gap-1.5 rounded-full border border-compdes-yellow/25 bg-compdes-blue-800 px-3.5 py-1.5 font-mono text-xs text-compdes-cream/85 transition-colors hover:border-compdes-yellow/70 hover:text-compdes-yellow"
            >
              <span class="text-compdes-yellow/50">&gt;_</span>
              <LangText value={field} />
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<!-- [ sec.02 ] Líneas prioritarias — explorador de archivos -->
<section id="lineas-tematicas" class="border-t border-compdes-cream/10 bg-compdes-blue-800 py-16 text-compdes-cream md:py-24">
  <div class="mx-auto max-w-6xl px-6">
    <SectionHeading
      sectionNumber={2}
      eyebrowKey="pageheader.tag.areas"
      titleKey="areas.tracks.title"
      introKey="areas.tracks.intro"
      align="center"
      dark
    />

    <div id="area-explorer" class="terminal-window corner mt-12 md:mt-16">
      <div class="term-titlebar">
        <span class="term-dots"><i></i><i></i><i></i></span>
        <span>$ tree /lineas_tematicas_2027</span>
        <span class="hidden sm:inline">v2027</span>
      </div>
      <div class="scanlines"></div>

      <p class="border-b border-dashed border-compdes-blue-600 px-5 py-2.5 font-mono text-[11px] tracking-wide text-compdes-cream/45 sm:px-6" data-i18n="areas.explorer.hint">
        {t('areas.explorer.hint')}
      </p>

      <div class="grid md:grid-cols-[280px_1fr]">
        {/* Árbol de directorios */}
        <ul
          role="tablist"
          aria-label={t('areas.tracks.title')}
          aria-orientation="vertical"
          class="tree flex gap-1 overflow-x-auto border-b border-compdes-blue-600 p-3 md:flex-col md:overflow-visible md:border-b-0 md:border-r"
        >
          {
            areaTracks.map((track, i) => (
              <li class="shrink-0 md:w-full">
                <button
                  type="button"
                  role="tab"
                  data-area-tab={track.id}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  tabindex={i === 0 ? 0 : -1}
                  class="tree-btn"
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 shrink-0" aria-hidden="true" set:html={ICONS[track.icon]} />
                  <span class="truncate">
                    {pad(i + 1)}_{track.id}/
                  </span>
                </button>
              </li>
            ))
          }
        </ul>

        {/* Paneles */}
        <div class="panel-zone p-5 sm:p-7">
          {
            areaTracks.map((track) => (
              <div role="tabpanel" data-area-panel={track.id}>
                <header class="flex items-center gap-3 border-b border-dashed border-compdes-blue-600 pb-4">
                  <span class="flex size-10 shrink-0 items-center justify-center rounded border border-compdes-yellow/40 bg-compdes-yellow/10 text-compdes-yellow">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5" aria-hidden="true" set:html={ICONS[track.icon]} />
                  </span>
                  <div class="min-w-0">
                    <p class="font-mono text-[11px] tracking-widest text-compdes-yellow/70">{pad(areaTracks.indexOf(track) + 1)}_{track.id}/</p>
                    <h3 class="font-display text-xl font-bold leading-tight text-compdes-cream md:text-2xl">
                      <LangText value={track.name} />
                    </h3>
                  </div>
                </header>

                <div class="mt-5 space-y-5">
                  {track.groups.map((group) => (
                    <div>
                      {group.title && (
                        <p class="mb-2 font-mono text-[13px] font-semibold text-compdes-yellow">
                          {'// '}
                          <LangText value={group.title} />
                        </p>
                      )}
                      <ul class="space-y-1.5 font-mono text-[13px] leading-relaxed text-compdes-cream/75">
                        {group.items.map((item, j) => (
                          <li class="flex gap-2.5">
                            <span class="select-none text-compdes-yellow/50" aria-hidden="true">
                              {j === group.items.length - 1 ? '└─' : '├─'}
                            </span>
                            <LangText value={item} />
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="flex items-center justify-between border-t border-compdes-blue-600 px-5 py-2.5 font-mono text-[11px] tracking-wide text-compdes-cream/40 sm:px-6">
        <span>{areaTracks.length} módulos · {topicCount} subtemas</span>
        <span>UTF-8 · LF</span>
      </div>
    </div>
  </div>
</section>

<script>
  /* Explorador: las pestañas son botones nativos con roving tabindex.
     Sin JS todos los paneles quedan visibles (mejora progresiva). */
  const root = document.getElementById('area-explorer');
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-area-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-area-panel]'));

    const select = (id: string | undefined, focus = false) => {
      if (!id) return;
      tabs.forEach((btn) => {
        const on = btn.dataset.areaTab === id;
        btn.setAttribute('aria-selected', String(on));
        btn.tabIndex = on ? 0 : -1;
        if (on && focus) btn.focus();
      });
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.areaPanel !== id;
      });
    };

    tabs.forEach((btn, index) => {
      btn.addEventListener('click', () => select(btn.dataset.areaTab));
      btn.addEventListener('keydown', (event) => {
        const key = (event as KeyboardEvent).key;
        let next = -1;
        if (key === 'ArrowDown' || key === 'ArrowRight') next = (index + 1) % tabs.length;
        else if (key === 'ArrowUp' || key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
        else if (key === 'Home') next = 0;
        else if (key === 'End') next = tabs.length - 1;
        if (next >= 0) {
          event.preventDefault();
          select(tabs[next].dataset.areaTab, true);
        }
      });
    });

    select(tabs[0]?.dataset.areaTab);
  }
</script>

<style>
  /* Botón del árbol: fila de explorador de archivos. El estado activo se
     maneja con aria-selected para que el CSS lo refleje sin clases extra. */
  .tree-btn {
    display: flex;
    width: 100%;
    align-items: center;
    gap: 0.55rem;
    padding: 0.45rem 0.65rem;
    border-radius: 0.375rem;
    border: 1px solid transparent;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-compdes-cream);
    opacity: 0.75;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease, opacity 0.2s ease;
  }

  .tree-btn:hover {
    background-color: color-mix(in srgb, var(--color-compdes-yellow) 8%, transparent);
    opacity: 1;
  }

  .tree-btn:focus-visible {
    outline: 2px solid var(--color-compdes-yellow);
    outline-offset: -2px;
  }

  .tree-btn[aria-selected='true'] {
    background-color: color-mix(in srgb, var(--color-compdes-yellow) 12%, transparent);
    border-color: color-mix(in srgb, var(--color-compdes-yellow) 45%, transparent);
    color: var(--color-compdes-yellow);
    opacity: 1;
  }

  @media (max-width: 767px) {
    .tree-btn {
      white-space: nowrap;
    }
  }
</style>
