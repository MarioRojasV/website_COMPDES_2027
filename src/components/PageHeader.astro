---
export interface Props {
  title: string;
  index: string;
  id?: string;
  tag?: string;
  status?: string;
}

const { title, index, id, tag = 'sección', status = 'EN PREPARACIÓN' } = Astro.props;
---

<section class="relative overflow-hidden border-b-2 border-compdes-yellow bg-compdes-blue text-compdes-cream">
  <div class="scanlines"></div>
  <div class="relative mx-auto max-w-5xl px-6 py-16 md:py-24">
    <p class="mb-4 text-[11px] uppercase tracking-[0.3em] text-compdes-yellow">
      [ mod.{index} ] // {tag}
    </p>
    <h1
      id={id}
      class="font-display text-4xl font-bold leading-tight md:text-5xl"
    >
      <span class="text-compdes-yellow">&gt;_</span>
      {title}
    </h1>
    <div class="mt-6 h-1 w-24 bg-compdes-yellow"></div>
  </div>
</section>

<section class="mx-auto max-w-5xl px-6 py-14">
  <div class="terminal-window corner">
    <div class="term-titlebar">
      <span class="term-dots"><i></i><i></i><i></i></span>
      <span>[ {tag} ]</span>
      <span class="hidden sm:inline">v2027</span>
    </div>
    <div class="px-6 py-7">
      <p class="flex items-center gap-2 text-xs uppercase tracking-[0.2em] text-compdes-yellow-600">
        <i class="status-led"></i>
        status: {status}
      </p>
      <p class="mt-3 text-sm leading-relaxed text-compdes-blue/80">
        Esta sección del sitio será actualizada próximamente con más información sobre esta área del
        congreso.
      </p>
    </div>
  </div>
</section>
