---
import { useTranslations } from '../i18n/ui';
import type { UiKey } from '../i18n/ui';

export interface Props {
  titleKey: UiKey;
  index: string;
  id?: string;
  tagKey?: UiKey;
  /** Descripción opcional bajo el título, dentro de la banda de cabecera. */
  descKey?: UiKey;
  /** Muestra el recuadro terminal "en preparación" bajo el encabezado. */
  placeholder?: boolean;
}

const lang = (Astro.currentLocale as 'es' | 'en') ?? 'es';
const t = useTranslations(lang);
const { titleKey, index, id, tagKey, descKey, placeholder = true } = Astro.props;
const tagLabel = tagKey ? t(tagKey) : t('common.section');
---

<section class="relative overflow-hidden border-b-2 border-compdes-yellow bg-compdes-blue text-compdes-cream">
  <div class="scanlines"></div>
  <div class="relative mx-auto max-w-5xl px-6 py-16 md:py-24">
    <p class="mb-4 text-[11px] uppercase tracking-[0.3em] text-compdes-yellow">
      [ mod.{index} ] // <span data-i18n={tagKey}>{tagLabel}</span>
    </p>
    <h1 id={id} class="font-display text-4xl font-bold leading-tight md:text-5xl" data-i18n={titleKey}>
      <span class="text-compdes-yellow">&gt;_</span>
      {t(titleKey)}
    </h1>
    <div class="mt-6 h-1 w-24 bg-compdes-yellow"></div>
    {
      descKey && (
        <p class="mt-6 max-w-xl text-sm leading-relaxed text-compdes-cream/80 md:text-[1.05rem]" data-i18n={descKey}>
          {t(descKey)}
        </p>
      )
    }
  </div>
</section>

{placeholder && (
<section class="mx-auto max-w-5xl px-6 py-14">
  <div class="terminal-window corner">
    <div class="term-titlebar">
      <span class="term-dots"><i></i><i></i><i></i></span>
      <span data-i18n={tagKey}>[ {tagLabel} ]</span>
      <span class="hidden sm:inline">v2027</span>
    </div>
    <div class="px-6 py-7">
      <p class="flex items-center gap-2 text-xs uppercase tracking-[0.2em] text-compdes-yellow">
        <i class="status-led"></i>
        <span data-i18n="common.inPreparation">status: {t('common.inPreparation')}</span>
      </p>
      <p class="mt-3 text-sm leading-relaxed text-compdes-cream/80" data-i18n="common.sectionComingSoon">
        {t('common.sectionComingSoon')}
      </p>
    </div>
  </div>
</section>
)}