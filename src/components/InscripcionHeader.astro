---
import { useTranslations } from '../i18n/ui';

const lang = (Astro.currentLocale as 'es' | 'en') ?? 'es';
const t = useTranslations(lang);
---

<section class="inscripcion-hero relative overflow-hidden border-b-2 border-compdes-yellow bg-compdes-blue-900 text-compdes-cream">
  <div class="inscripcion-art" aria-hidden="true">
    <img
      class="inscripcion-art__bg"
      src={`${import.meta.env.BASE_URL}/elementos/fondo_lapa.webp`}
      alt=""
      decoding="async"
      draggable="false"
    />
    <img
      class="inscripcion-art__bird"
      src={`${import.meta.env.BASE_URL}/elementos/lapa.webp`}
      alt=""
      decoding="async"
      draggable="false"
    />
  </div>
  <div class="scanlines"></div>
  <div class="relative z-10 mx-auto max-w-5xl px-6 py-16 md:py-24">
    <p class="mb-4 text-[11px] uppercase tracking-[0.3em] text-compdes-yellow">
      [ mod.02 ] //
      <span data-i18n="pageheader.tag.inscripcion">{t('pageheader.tag.inscripcion')}</span>
    </p>
    <h1 id="titulo" class="font-display text-4xl font-bold leading-tight md:text-5xl">
      <span class="text-compdes-yellow">&gt;_</span>{' '}
      <span data-i18n="pageheader.title.inscripcion">{t('pageheader.title.inscripcion')}</span>
    </h1>
    <div class="mt-6 h-1 w-24 bg-compdes-yellow"></div>
    <p
      class="mt-6 max-w-xl text-sm leading-relaxed text-compdes-cream/80 md:text-[1.05rem]"
      data-i18n="pageheader.desc.inscripcion"
    >
      {t('pageheader.desc.inscripcion')}
    </p>
  </div>
</section>

<section class="mx-auto max-w-5xl px-6 py-14">
  <div class="terminal-window corner">
    <div class="term-titlebar">
      <span class="term-dots"><i></i><i></i><i></i></span>
      <span data-i18n="pageheader.tag.inscripcion">[ {t('pageheader.tag.inscripcion')} ]</span>
      <span class="hidden sm:inline">v2027</span>
    </div>
    <div class="px-6 py-7">
      <p class="flex items-center gap-2 text-xs uppercase tracking-[0.2em] text-compdes-yellow">
        <i class="status-led"></i>
        <span data-i18n="common.inPreparation">status: {t('common.inPreparation')}</span>
      </p>
      <p class="mt-3 text-sm leading-relaxed text-compdes-cream/80" data-i18n="common.sectionComingSoon">
        {t('common.sectionComingSoon')}
      </p>
    </div>
  </div>
</section>

<style>
  /* Composición de dos capas anclada al borde derecho de la banda (misma
     receta validada en TurismoHeader, con clases propias para que los
     querySelector de cada página nunca colisionen). */
  .inscripcion-art {
    position: absolute;
    top: 50%;
    right: 0;
    transform: translateY(-50%);
    height: 100%;
    width: min(46vw, 640px);
    overflow: hidden;
    pointer-events: none;
    user-select: none;
    display: none;
  }

  @media (min-width: 768px) {
    .inscripcion-art {
      display: block;
    }
  }

  /* Ambas capas sobredimensionadas (bleed) para que el desplazamiento del
     parallax nunca deje bordes descubiertos. El sangrado extra por la derecha
     recorta fuera de pantalla cualquier margen transparente interno de las
     imágenes → pegado total al borde del viewport.
     max-width:none anula el `img { max-width: 100% }` del preflight de
     Tailwind, que si no colapsa las capas al ancho del contenedor. */
  .inscripcion-art__bg,
  .inscripcion-art__bird {
    position: absolute;
    inset: -9% -18% -9% -9%;
    width: auto;
    max-width: none;
    height: 118%;
    will-change: transform;
  }

  .inscripcion-art__bg {
    object-fit: cover;
    object-position: right center;
    /* Disolución alfa EXCLUSIVA de esta capa (selva): rampa larga de 7
       paradas con crecimiento casi exponencial — disolución progresiva y
       orgánica hacia el azul de la página, sin velo adicional. El borde
       derecho llega SÓLIDO hasta el viewport, sin fundido de salida. */
    -webkit-mask-image:
      linear-gradient(
        to right,
        transparent 0%,
        rgb(0 0 0 / 0.03) 15%,
        rgb(0 0 0 / 0.1) 28%,
        rgb(0 0 0 / 0.22) 40%,
        rgb(0 0 0 / 0.42) 52%,
        rgb(0 0 0 / 0.65) 64%,
        rgb(0 0 0 / 0.85) 76%,
        #000 90%,
        #000 100%
      ),
      linear-gradient(
        to bottom,
        transparent 0%,
        rgb(0 0 0 / 0.35) 14%,
        #000 34%,
        #000 68%,
        rgb(0 0 0 / 0.35) 86%,
        transparent 100%
      );
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(
        to right,
        transparent 0%,
        rgb(0 0 0 / 0.03) 15%,
        rgb(0 0 0 / 0.1) 28%,
        rgb(0 0 0 / 0.22) 40%,
        rgb(0 0 0 / 0.42) 52%,
        rgb(0 0 0 / 0.65) 64%,
        rgb(0 0 0 / 0.85) 76%,
        #000 90%,
        #000 100%
      ),
      linear-gradient(
        to bottom,
        transparent 0%,
        rgb(0 0 0 / 0.35) 14%,
        #000 34%,
        #000 68%,
        rgb(0 0 0 / 0.35) 86%,
        transparent 100%
      );
    mask-composite: intersect;
  }

  .inscripcion-art__bird {
    /* El img es un elemento REEMPLAZADO: se dimensiona por ANCHO (= ventana
       visible) para que contain dibuje la lapa completa, anclada al borde
       derecho y centrada en vertical. max-height la protege cuando la
       ventana crece más que la banda (contain letterboxea sin distorsión).
       Sin máscara ni filtros: conserva su recorte alfa original, nítido. */
    inset: 0 0 0 auto;
    width: 100%;
    height: auto;
    max-height: 100%;
    margin-block: auto;
    object-fit: contain;
    object-position: right center;
  }
</style>

<script>
  const section = document.querySelector('.inscripcion-hero');
  const bg = document.querySelector('.inscripcion-art__bg');
  const bird = document.querySelector('.inscripcion-art__bird');

  if (section && bg && bird) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Velocidades intencionalmente asimétricas: fondo lejano casi estático,
    // lapa cercana con recorrido amplio y evidente.
    const BG_SPEED = 30;
    const BIRD_SPEED = 320;
    // Resorte subamortiguado de la lapa: ω fija el periodo (2π/ω ≈ 0.52 s,
    // el retraso con que alcanza al fondo) y ζ < 1 hace que sobrepase su
    // objetivo una vez y rebote antes de asentarse en su lugar.
    const SPRING_OMEGA = 12; // rad/s
    const SPRING_ZETA = 0.5; // razón de amortiguación (<1 = subamortiguado)
    // Entrada escénica: la lapa arranca fuera del encuadre (por arriba de la
    // banda) y "aterriza" con este mismo resorte la primera vez que la
    // sección asoma en pantalla.
    const ENTER_OFFSET = 460;
    // Flotación idle: oscilación senoidal continua que suma vida a la lapa
    // cuando no hay scroll. Es HORIZONTAL porque el recorte alfa de la lapa
    // casi toca el borde inferior de su lienzo (1px de holgura): cualquier
    // vaivén vertical marcaría cortes; lateralmente sobran >100px por lado.
    const IDLE_AMP = 8; // px
    const IDLE_PERIOD = 3.2; // s

    let targetBgY = 0;
    let targetBirdY = 0;
    let birdY = 0;
    let birdV = 0;
    let idlePhase = 0;
    let rafId = null;
    let lastT = 0;
    // Con motion reducido no hay puesta en escena ni flotación: estático.
    let entered = reduceMotion;

    function computeTargets() {
      const rect = section.getBoundingClientRect();
      const vh = window.innerHeight || 1;
      // 0 cuando la sección aún entra por abajo, 1 cuando ya salió por arriba.
      const p = Math.min(Math.max((vh - rect.top) / (vh + rect.height), 0), 1);
      const centered = p - 0.5;
      targetBgY = centered * BG_SPEED;
      targetBirdY = centered * BIRD_SPEED;
    }

    function render() {
      bg.style.transform = `translate3d(0, ${targetBgY.toFixed(1)}px, 0)`;
      const idleX = entered && !reduceMotion ? Math.sin(idlePhase) * IDLE_AMP : 0;
      bird.style.transform = `translate3d(${idleX.toFixed(1)}px, ${(reduceMotion ? 0 : birdY).toFixed(1)}px, 0)`;
    }

    // Bucle persistente tras la entrada: integra el resorte hacia su objetivo
    // y avanza la fase de flotación. Coste por frame ínfimo (dos transforms).
    function frame(t) {
      const dt = Math.min(Math.max((t - lastT) / 1000, 0), 1 / 30);
      lastT = t;

      const accel =
        SPRING_OMEGA * SPRING_OMEGA * (targetBirdY - birdY) -
        2 * SPRING_ZETA * SPRING_OMEGA * birdV;
      birdV += accel * dt;
      birdY += birdV * dt;
      if (Math.abs(targetBirdY - birdY) < 0.3 && Math.abs(birdV) < 8) {
        birdY = targetBirdY;
        birdV = 0;
      }

      idlePhase += (dt * 2 * Math.PI) / IDLE_PERIOD;
      render();
      rafId = requestAnimationFrame(frame);
    }

    function wake() {
      if (!entered) return; // antes de la entrada no hay nada que mover
      // Con bucle persistente los objetivos SIEMPRE se actualizan al hacer
      // scroll; el guard de rafId solo decide si hay que arrancar el bucle.
      computeTargets();
      if (rafId === null) {
        lastT = performance.now();
        rafId = requestAnimationFrame(frame);
      }
    }

    // Revelado de la selva: tween de opacity conducido por rAF (easeOutCubic).
    // No depende del reloj de transiciones CSS, que en algunos entornos no
    // avanza; así el fundido es idéntico en cualquier navegador.
    const BG_FADE_MS = 900;
    let fadeRaf = null;

    function startBgFade() {
      if (reduceMotion || fadeRaf !== null) return;
      const t0 = performance.now();
      function step(t) {
        const k = Math.min((t - t0) / BG_FADE_MS, 1);
        bg.style.opacity = (1 - Math.pow(1 - k, 3)).toFixed(3);
        fadeRaf = k < 1 ? requestAnimationFrame(step) : null;
      }
      fadeRaf = requestAnimationFrame(step);
    }

    function startEntrance() {
      entered = true;
      // Un frame de respiro para que el estado oculto llegue a pintarse
      // antes de arrancar el revelado y el aterrizaje de la lapa.
      requestAnimationFrame(() => {
        void bg.offsetWidth;
        startBgFade();
        wake();
      });
    }

    // Estado inicial: sin motion reducido la lapa se coloca fuera del
    // encuadre y la selva en opacity 0, a la espera del IntersectionObserver.
    computeTargets();
    render();

    if (!reduceMotion) {
      birdY = targetBirdY - ENTER_OFFSET;
      render();
      bg.style.opacity = '0';

      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            if (entries.some((e) => e.isIntersecting)) {
              io.disconnect();
              startEntrance();
            }
          },
          { threshold: 0.25 }
        );
        io.observe(section);
      } else {
        startEntrance();
      }

      window.addEventListener('scroll', wake, { passive: true });
      window.addEventListener('resize', wake, { passive: true });
    }
  }
</script>
