---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="COMPDES 2027 — Inicio">
  <section class="hero">
    <img class="hero-bg" src="/fondos/principal.webp" alt="" />

    <img id="hero-logo" class="hero-logo" src="/fondos/volcano.webp" alt="Volcán" />

    <div class="hero-scrim"></div>

    <div class="hero-inner">
      <h1 class="hero-title font-display font-bold">
        <span class="block">COMPDES</span>
        <span class="block text-compdes-yellow">2027</span>
      </h1>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="mx-auto max-w-4xl px-6">
      <p class="text-[11px] uppercase tracking-[0.3em] text-compdes-yellow-600">[ sec.01 ] // inicio</p>
      <h2 class="mt-3 font-display text-2xl font-bold md:text-3xl">¿Qué es COMPDES?</h2>
      <div class="mt-5 h-1 w-16 bg-compdes-yellow"></div>
      <p class="mt-6 leading-relaxed text-compdes-blue/80">
        Bienvenido al Congreso COMPDES 2027. Este sitio web contiene información sobre el congreso,
        programación e inscripciones.
      </p>
      <p class="mt-4 leading-relaxed text-compdes-blue/80">
        COMPDES es un congreso académico y científico que reúne a investigadores, docentes y
        estudiantes para compartir conocimientos y avances en diversas áreas del conocimiento.
      </p>
      <p class="mt-4 leading-relaxed text-compdes-blue/80">
        El evento incluye conferencias magistrales, presentaciones de trabajos de investigación,
        talleres y espacios de networking. Está dirigido a la comunidad académica y profesional
        interesada en la difusión de la ciencia y la tecnología.
      </p>
    </div>
  </section>

  <section class="border-y-2 border-compdes-yellow bg-compdes-blue py-16 text-compdes-cream md:py-24">
    <div class="mx-auto max-w-4xl px-6">
      <p class="text-[11px] uppercase tracking-[0.3em] text-compdes-yellow">[ sec.02 ] // datos</p>
      <h2 class="mt-3 font-display text-2xl font-bold md:text-3xl">Información</h2>
      <div class="mt-5 h-1 w-16 bg-compdes-yellow"></div>
      <p class="mt-6 leading-relaxed text-compdes-cream/85">
        Aquí encontrará información general sobre el congreso, incluyendo fechas importantes,
        requisitos de participación y lineamientos para la presentación de trabajos. Esta sección
        será actualizada próximamente con detalles adicionales.
      </p>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="mx-auto max-w-4xl px-6">
      <p class="text-[11px] uppercase tracking-[0.3em] text-compdes-yellow-600">[ sec.03 ] // contacto</p>
      <h2 class="mt-3 font-display text-2xl font-bold md:text-3xl">Contacto</h2>
      <div class="mt-5 h-1 w-16 bg-compdes-yellow"></div>

      <div class="terminal-window corner mt-8">
        <div class="term-titlebar">
          <span class="term-dots"><i></i><i></i><i></i></span>
          <span>contacto</span>
          <span class="hidden sm:inline">fs</span>
        </div>
        <div class="space-y-3 px-6 py-6 font-mono text-sm">
          <p class="text-compdes-blue">
            <span class="text-compdes-blue/60">correo: </span>compdes2027@example.com
          </p>
          <p class="text-compdes-blue">
            <span class="text-compdes-blue/60">tel: </span>+51 999 999 999
          </p>
          <p class="text-compdes-blue">
            <span class="text-compdes-blue/60">social: </span>@compdes2027 · Facebook, X, Instagram
          </p>
          <p class="pt-2 text-compdes-yellow-600">
            <span class="blink">▌</span>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="border-y-2 border-compdes-yellow bg-compdes-blue py-16 text-compdes-cream md:py-24">
    <div class="mx-auto max-w-4xl px-6">
      <p class="text-[11px] uppercase tracking-[0.3em] text-compdes-yellow">[ sec.04 ] // ubicación</p>
      <h2 class="mt-3 font-display text-2xl font-bold md:text-3xl">Sede</h2>
      <div class="mt-5 h-1 w-16 bg-compdes-yellow"></div>
      <p class="mt-6 leading-relaxed text-compdes-cream/85">
        La información de la sede del congreso estará disponible próximamente.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    height: 100vh;
    min-height: 560px;
    overflow: hidden;
    background-color: var(--color-compdes-blue);
  }

  .hero-bg,
  .hero-logo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    will-change: transform;
  }

  .hero-bg {
    transform: scale(1.15);
  }

  .hero-logo {
    transform: scale(1.2);
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(to bottom, rgb(0 49 83 / 0.35), transparent 35%),
      linear-gradient(to top, rgb(0 49 83 / 0.45), transparent 40%);
    pointer-events: none;
  }

  .hero-inner {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding: 0 max(1.5rem, 6vw);
    text-align: left;
    will-change: transform;
  }

  .hero-title {
    color: var(--color-compdes-cream);
    font-size: clamp(3.5rem, 11vw, 8.5rem);
    line-height: 1.05;
    letter-spacing: 0.01em;
    text-shadow:
      0 2px 6px rgb(0 0 0 / 0.55),
      0 10px 40px rgb(0 0 0 / 0.45);
    will-change: transform, opacity;
  }
</style>

<script>
  const hero = document.querySelector('.hero');
  const bg = document.querySelector('.hero-bg');
  const logo = document.querySelector('#hero-logo');
  const title = document.querySelector('.hero-title');

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let ticking = false;

  function update() {
    ticking = false;
    if (reduceMotion || !hero) return;

    const max = hero.offsetHeight;
    if (max === 0) return;

    const y = Math.max(0, window.scrollY);
    const p = Math.min(y / max, 1);

    if (bg) bg.style.transform = `scale(1.15) translate3d(0, ${p * 40}px, 0)`;
    if (logo) logo.style.transform = `scale(1.2) translate3d(0, ${p * 95}px, 0)`;
    if (title) {
      title.style.transform = `translate3d(0, ${p * 180}px, 0)`;
      title.style.opacity = String(1 - p * 0.35);
    }
  }

  function onScroll() {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(update);
    }
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  update();
</script>
