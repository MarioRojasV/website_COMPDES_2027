---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import CommitteeSection from '../../components/organizacion/CommitteeSection.astro';
import { committees } from '../../data/organizacion';
import fondoMorpho from '../../assets/images/headers/fondo-morpho.webp';
import morpho from '../../assets/images/headers/morpho.webp';
import morpho2 from '../../assets/images/headers/morpho-2.webp';
---

<BaseLayout titleKey="page.title.organizacion" descriptionKey="meta.desc.organizacion">
  <PageHeader
    titleKey="nav.organizacion"
    index="07"
    tagKey="pageheader.tag.organizacion"
    descKey="pageheader.desc.organizacion"
    placeholder={false}
    artBgSrc={fondoMorpho}
    artBirdSrc={morpho}
    artBird2Src={morpho2}
  />
  {committees.map((committee, i) => (
    <CommitteeSection
      committeeId={committee.id}
      sectionNumber={i + 1}
      members={committee.members}
      alt={i % 2 === 1}
      comingSoon={committee.id === 'cientifico'}
    />
  ))}
</BaseLayout>
