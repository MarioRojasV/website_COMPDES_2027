---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import KeyDates from '../../components/cronograma/KeyDates.astro';
import DailyProgram from '../../components/cronograma/DailyProgram.astro';
import TalksAgenda from '../../components/cronograma/TalksAgenda.astro';
---

<BaseLayout titleKey="page.title.cronograma" descriptionKey="meta.desc.cronograma">
  <PageHeader
    titleKey="nav.cronograma"
    index="04"
    tagKey="pageheader.tag.cronograma"
    descKey="pageheader.desc.cronograma"
    placeholder={false}
    artBgSrc={`${import.meta.env.BASE_URL}/elementos/fondo_perezoso.webp`}
    artBirdSrc={`${import.meta.env.BASE_URL}/elementos/perezoso.webp`}
  />
  <KeyDates />
  <DailyProgram />
  <TalksAgenda />
</BaseLayout>
