---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { defaultLang, ui, useTranslations, localizedUrl } from '../i18n/ui';

export interface Props {
  /** Translation key for the <title> tag (must exist in both dictionaries). */
  titleKey: keyof typeof ui[typeof defaultLang];
  /** Translation key for the meta description. */
  descriptionKey?: keyof typeof ui[typeof defaultLang];
}

const { titleKey, descriptionKey = 'meta.desc.home' } = Astro.props;

const lang = (Astro.currentLocale as 'es' | 'en') ?? 'es';
const t = useTranslations(lang);
const title = t(titleKey);
const description = t(descriptionKey);
const SITE_TITLE = 'COMPDES 2027';

const canonicalPath = Astro.url.pathname;
const canonicalURL = new URL(canonicalPath, Astro.site ?? 'https://www.compdes.org/compdes2027/');
const alternateLang: 'es' | 'en' = lang === 'es' ? 'en' : 'es';
const alternateURL = new URL(localizedUrl(canonicalPath, alternateLang), Astro.site);

// Con `base` configurado el pathname llega como '/compdes2027/...'. Se quita
// el prefijo y se prueba la ruta relativa directamente (localizedUrl también
// antepone el base, así que comparar contra '/' nunca cuadraría).
const bareBase = import.meta.env.BASE_URL.replace(/\/$/, '');
const relativePath = canonicalPath.startsWith(bareBase)
  ? canonicalPath.slice(bareBase.length) || '/'
  : canonicalPath;
const isHome = /^\/(en\/?)?$/.test(relativePath);
---

<!doctype html>
<html
  lang={lang}
  data-i18n-title={titleKey}
  data-i18n-desc={descriptionKey}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fdf8ef" />

    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}/favicon.ico`} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL} />
    <link rel="alternate" hreflang={alternateLang} href={alternateURL} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={lang === 'es' ? 'es_CR' : 'en_US'} />
    <meta property="og:url" content={canonicalURL} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="flex min-h-screen flex-col bg-compdes-cream font-mono text-compdes-blue">
    <a class="skip-link" href="#main" data-i18n="common.skipLink">{t('common.skipLink')}</a>
    <Navbar currentPath={canonicalPath} lang={lang} transparent={isHome} />
    <main id="main" class:list={['flex-1', !isHome && 'bg-compdes-blue']}>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>